<?xml version="1.0" encoding="utf-8"?>
<!--
  pkavule.zxadocslib is hosted on GitHub Packages (ZD-30). GitHub requires authentication to
  restore a NuGet package even when it is public, so every build needs a token:

    export GH_PACKAGES_TOKEN=<a GitHub PAT with read:packages>

  Sources here are ADDED to the ones in the user-level config (nuget.org and any local feed) —
  there is deliberately no <clear />, or every other PackageReference would stop resolving.
-->
<configuration>
  <packageSources>
    <add key="ghpaul" value="https://nuget.pkg.github.com/paulkavule/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <ghpaul>
      <add key="Username" value="paulkavule" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </ghpaul>
  </packageSourceCredentials>
</configuration>
