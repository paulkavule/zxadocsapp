@using Microsoft.VisualBasic
@inherits LayoutComponentBase

<div class="d-flex text-blue-50" style="background-color: indianred;">
    <div id="side-title" class="d-none d-md-flex flex-column p-2 fs-2 text-center align-items-center"
        style="height:50px; background-color:#e6e6e6;">
        <span class="bg-amber-700">Zxadocs</span>
    </div>
    <div class="flex-grow-1"></div>
</div>

<div class="d-flex min-vh-100">
    <!-- Side Menu -->
    <div id="side-menu" class="d-none d-md-flex flex-column">

        <Menu Items="@menuItems" DisableNavigation="true" IsVertical="true" IsCollapsed="true" class="vh-100"
            style="border-right: 1px solid #e6e6e6; padding-right: 4px;">
        </Menu>

    </div>

    <!-- Main Content -->
    <div class="flex-grow-1">
        @Body
    </div>
</div>