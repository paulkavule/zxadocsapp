@page "/reset-password"
@rendermode InteractiveServer

@* Anonymous by design: this is the page the emailed link opens, and the visitor holds no token
   pair yet. Routes.razor applies no authorisation, so nothing further is needed here. *@

<div class="min-h-screen font-sans antialiased flex items-center justify-center p-5 reset-backdrop">
    <div class="w-full max-w-md">
        <div class="reset-card rounded-3xl shadow-2xl p-8 relative overflow-hidden">
            <div class="relative">
                <div class="flex items-center gap-3 mb-6">
                    <div class="bg-[#1f7b4d] text-white p-3 rounded-2xl shadow-md">
                        <img src="/images/zxadocs_icon_124_white.png" width="30px" alt="zxadocs" />
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-[#195d3a]">Choose your password</h1>
                        <p class="text-xs text-[#5f8b74]">zxadocs · secure document workflow</p>
                    </div>
                </div>

                @if (!HasToken)
                {
                    @* No token in the query, or one the server has already refused. The form is not
                       rendered at all: there is nothing a password could be submitted against. *@
                    <div class="mb-4">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            @(_failure ?? "This link is invalid or has expired.")
                        </MudAlert>
                    </div>
                    <p class="text-sm text-[#2a5f40] mb-6">
                        Ask an administrator to send a new invitation, or use "Forgot password?" on the
                        sign-in page.
                    </p>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Login">
                        Back to sign in
                    </MudButton>
                }
                else
                {
                    <p class="text-sm text-[#2a5f40] mb-5">
                        Set a password you have not used here before. You will sign in with it straight
                        after.
                    </p>

                    @if (_failure is not null)
                    {
                        <div class="mb-4">
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                                @_failure
                            </MudAlert>
                        </div>
                    }

                    <MudForm Model="@_model" @ref="_form" Validation="@(_validator.ValidateValue)"
                             @bind-IsValid="@_isValid" Class="flex flex-col gap-4">
                        <MudTextField Label="New password" Variant="Variant.Outlined"
                                      InputType="InputType.Password" Immediate="true"
                                      @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)" />

                        <MudTextField Label="Confirm password" Variant="Variant.Outlined"
                                      InputType="InputType.Password" Immediate="true"
                                      @bind-Value="_model.Confirm" For="@(() => _model.Confirm)" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   EndIcon="@Icons.Material.Filled.LockReset"
                                   Disabled="@_saving" OnClick="Submit">
                            @(_saving ? "Saving..." : "Set password and continue")
                        </MudButton>
                    </MudForm>
                }

                <div class="flex items-center justify-center gap-1 mt-6 text-xs text-[#8bb89b]">
                    <i class="fa-solid fa-lock"></i>
                    <span>zxadocs · end-to-end encrypted</span>
                </div>
            </div>
        </div>
    </div>
</div>
