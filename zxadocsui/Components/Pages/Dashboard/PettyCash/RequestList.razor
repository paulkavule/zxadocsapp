@page "/petty-cash/requests"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-receipt text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Petty cash requests</h1>
            <p class="text-xs text-slate-500">UGX</p>
        </div>
    </div>

    <div class="p-6 space-y-4">
        <div class="flex items-center justify-between gap-4">
            <MudChipSet T="string" @bind-SelectedValue="scope" SelectionMode="SelectionMode.SingleSelection" CheckMark="true">
                @foreach (var option in scopes)
                {
                    <MudChip T="string" Value="@option.Value" Text="@option.Label" OnClick="@(() => Switch(option.Value))" />
                }
            </MudChipSet>
            <div class="flex items-center gap-3">
                <ExportButtons Url="@ListUrl" FileStem="petty-cash-requests" />
                @if (canCreate)
                {
                    <MudButton Href="/petty-cash/requests/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                        New request
                    </MudButton>
                }
            </div>
        </div>

        <MudTable Items="@requests" Hover="true" Dense="true" Striped="true" Elevation="0" Loading="@loading"
                  LoadingProgressColor="Color.Primary" OnRowClick="@((TableRowClickEventArgs<PettyCashRequestDto> e) => Open(e.Item!))" T="PettyCashRequestDto">
            <HeaderContent>
                <MudTh>Reference</MudTh><MudTh>Unit</MudTh><MudTh>Category</MudTh><MudTh>Payee</MudTh>
                <MudTh>Amount</MudTh><MudTh>Maker</MudTh><MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Reference">@context.Reference</MudTd>
                <MudTd DataLabel="Unit">@context.BillingUnitCode</MudTd>
                <MudTd DataLabel="Category">@context.CategoryName</MudTd>
                <MudTd DataLabel="Payee">@(context.PaymentType == PaymentType.Utility ? context.UtilityAccountLabel : context.BeneficiaryPhone)</MudTd>
                <MudTd DataLabel="Amount">@context.Amount.ToString("N0")</MudTd>
                <MudTd DataLabel="Maker">@context.CreatedBy</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context)">@StatusText(context)</MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No requests here.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
