@page "/petty-cash/workflows"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-list-check text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Approval workflows</h1>
            <p class="text-xs text-slate-500">a change becomes a new version; submitted requests keep theirs</p>
        </div>
    </div>

    <div class="p-6 space-y-6">
        @if (canEdit)
        {
            <div class="flex justify-end">
                <MudButton OnClick="@(() => OpenEditor(new ApprovalWorkflowDto { Levels = [new ApprovalLevelDto()] }))"
                           Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    New workflow
                </MudButton>
            </div>
        }

        <MudTable Items="@workflows" Hover="true" Dense="true" Striped="true" Elevation="0"
                  Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Name</MudTh><MudTh>Version</MudTh><MudTh>Levels</MudTh><MudTh>Status</MudTh><MudTh Style="width:60px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    @context.Name
                    @if (context.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Default</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Version">@context.Version</MudTd>
                <MudTd DataLabel="Levels">
                    @foreach (var level in context.Levels)
                    {
                        <div class="text-xs">@level.Order. @level.RoleName @Band(level)</div>
                    }
                </MudTd>
                <MudTd DataLabel="Status">@(context.IsActive ? "Active" : "Inactive")</MudTd>
                <MudTd>
                    @if (canEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => OpenEditor(context))" aria-label="Edit workflow" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No workflows yet. The first request creates a default Maker &rarr; Checker one.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
