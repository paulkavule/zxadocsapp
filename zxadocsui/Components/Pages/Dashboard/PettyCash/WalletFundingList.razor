@page "/petty-cash/fundings"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-money-bill-transfer text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Wallet funding</h1>
            <p class="text-xs text-slate-500">a wallet balance rises only when someone other than the initiator approves</p>
        </div>
    </div>

    <div class="p-6 space-y-6">
        @if (canInitiate)
        {
            <div class="flex justify-end">
                <MudButton OnClick="OpenEditor" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    New funding
                </MudButton>
            </div>
        }

        <MudTable Items="@fundings" Hover="true" Dense="true" Striped="true" Elevation="0"
                  Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Wallet</MudTh><MudTh>Amount</MudTh><MudTh>Source</MudTh><MudTh>Reference</MudTh><MudTh>Date</MudTh>
                <MudTh>Initiated by</MudTh><MudTh>Status</MudTh><MudTh>Journal</MudTh><MudTh Style="width:100px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Wallet">@context.BillingUnitCode</MudTd>
                <MudTd DataLabel="Amount">@context.Amount.ToString("N0")</MudTd>
                <MudTd DataLabel="Source">@context.Source</MudTd>
                <MudTd DataLabel="Reference">@context.Reference</MudTd>
                <MudTd DataLabel="Date">@context.FundingDate.ToString("d MMM yyyy")</MudTd>
                <MudTd DataLabel="Initiated by">@context.InitiatedBy</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
                    @if (context.Status == FundingStatus.Rejected)
                    {
                        <div class="text-xs text-slate-500">@context.RejectionReason</div>
                    }
                    else if (context.DecidedBy.Length > 0)
                    {
                        <div class="text-xs text-slate-500">by @context.DecidedBy</div>
                    }
                </MudTd>
                <MudTd DataLabel="Journal">@context.JournalNumber</MudTd>
                <MudTd>
                    @if (canApprove && context.Status == FundingStatus.Pending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                       OnClick="@(() => Approve(context))" aria-label="Approve funding" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => Reject(context))" aria-label="Reject funding" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No fundings yet.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
