@page "/petty-cash/requests/{Id:int}"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-receipt text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Request @review?.Request.Reference</h1>
            <p class="text-xs text-slate-500">@StatusLine()</p>
        </div>
    </div>

    @if (review is null)
    {
        <div class="py-10 text-center text-slate-500">Loading…</div>
    }
    else
    {
        var r = review.Request;
        <div class="p-6 grid gap-6 max-w-3xl">
            @if (r.AccountingStatus == AccountingStatus.Failed)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    Accounting failed: @r.AccountingError
                    @if (canRetryAccounting)
                    {
                        <MudButton OnClick="RetryAccounting" Disabled="@busy" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2">
                            Retry accounting
                        </MudButton>
                    }
                </MudAlert>
            }
            @foreach (var warning in review.Warnings)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@warning</MudAlert>
            }

            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td class="text-slate-500 w-48">Amount</td><td><strong>UGX @r.Amount.ToString("N0")</strong></td></tr>
                    <tr><td class="text-slate-500">Category</td><td>@r.CategoryName</td></tr>
                    <tr><td class="text-slate-500">Billing unit</td><td>@r.BillingUnitCode &middot; cost centre @r.CostCentre</td></tr>
                    <tr><td class="text-slate-500">Wallet available</td><td>UGX @review.WalletAvailable.ToString("N0")</td></tr>
                    @if (r.PaymentType == PaymentType.Utility)
                    {
                        <tr><td class="text-slate-500">Utility account</td><td>@r.UtilityAccountLabel</td></tr>
                    }
                    else
                    {
                        <tr><td class="text-slate-500">Beneficiary</td><td>@r.BeneficiaryPhone &middot; @r.BeneficiaryName</td></tr>
                        <tr><td class="text-slate-500">Provider check</td><td><BeneficiaryResult Request="@r" /></td></tr>
                    }
                    <tr><td class="text-slate-500">Purpose</td><td>@r.Description</td></tr>
                    <tr><td class="text-slate-500">Raised by</td><td>@r.CreatedBy, submitted @r.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy HH:mm")</td></tr>
                </tbody>
            </MudSimpleTable>

            <RequestAttachments RequestId="@r.Id" Editable="false" />

            <section>
                <h2 class="text-sm font-semibold text-slate-700 mb-2">Approval history</h2>
                @if (review.History.Count == 0)
                {
                    <p class="text-sm text-slate-400">No decisions yet.</p>
                }
                @foreach (var step in review.History)
                {
                    <div class="text-sm border-b border-slate-100 py-1">
                        Level @step.Level &middot; <strong>@step.Action</strong> by @step.UserName (@step.RoleName),
                        @step.At.ToLocalTime().ToString("d MMM HH:mm")
                        @if (step.Comment.Length > 0) { <span class="text-slate-500"> &mdash; @step.Comment</span> }
                    </div>
                }
            </section>

            @if (review.CanAct)
            {
                <section class="space-y-2">
                    <MudTextField @bind-Value="comment" Label="Comment (required to return or reject)" Immediate="true" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
                    <div class="flex gap-2">
                        <MudButton OnClick="Approve" Disabled="@busy" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check">
                            Approve level @r.CurrentLevel
                        </MudButton>
                        <MudButton OnClick="Return" Disabled="@(busy || string.IsNullOrWhiteSpace(comment))" Variant="Variant.Outlined"
                                   Color="Color.Warning" StartIcon="@Icons.Material.Filled.Undo">
                            Return to maker
                        </MudButton>
                        <MudButton OnClick="Reject" Disabled="@(busy || string.IsNullOrWhiteSpace(comment))" Variant="Variant.Outlined"
                                   Color="Color.Error" StartIcon="@Icons.Material.Filled.Block">
                            Reject
                        </MudButton>
                    </div>
                </section>
            }
            else if (r.Status == RequestStatus.UnderApproval && review.CannotActReason.Length > 0)
            {
                <p class="text-xs text-slate-500">You cannot act on this request: @review.CannotActReason.</p>
            }

            <MudButton Href="/petty-cash/requests" Variant="Variant.Text">Back to requests</MudButton>
        </div>
    }
</div>
