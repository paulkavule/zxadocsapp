@page "/petty-cash/billing-units"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-building-columns text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Billing units</h1>
            <p class="text-xs text-slate-500">empty limits fall back to the petty cash policy</p>
        </div>
    </div>

    <div class="p-6 space-y-6">
        @if (canEdit)
        {
            <div class="flex justify-end">
                <MudButton OnClick="@(() => OpenEditor(new BillingUnitDto()))" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add">
                    New billing unit
                </MudButton>
            </div>
        }

        <MudTable Items="@units" Hover="true" Dense="true" Striped="true" Elevation="0"
                  Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Department</MudTh><MudTh>Cost centre</MudTh>
                <MudTh>Per txn</MudTh><MudTh>Daily</MudTh><MudTh>Monthly</MudTh><MudTh>Status</MudTh>
                <MudTh Style="width:60px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Department">@context.DepartmentName</MudTd>
                <MudTd DataLabel="Cost centre">@context.CostCentre</MudTd>
                <MudTd DataLabel="Per txn">@Money(context.PerTransactionLimit)</MudTd>
                <MudTd DataLabel="Daily">@Money(context.DailyLimit)</MudTd>
                <MudTd DataLabel="Monthly">@Money(context.MonthlyLimit)</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>
                <MudTd>
                    @if (canEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => OpenEditor(context))" aria-label="Edit billing unit" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No billing units yet.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
