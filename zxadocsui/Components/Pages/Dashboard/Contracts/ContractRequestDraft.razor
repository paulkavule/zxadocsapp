@page "/contract-requests/{Id:int}/draft"
@layout DashboardLayout
@using zxadocslib.Dtos
@using zxadocsui.Components.Custom

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90 backdrop-blur-sm">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-pen-nib text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Draft this contract</h1>
            <p class="text-xs text-slate-500">
                @reference — choose the template to write it from
            </p>
        </div>
    </div>

    <div class="p-6">
        @if (loading)
        {
            <div class="py-10 text-center text-slate-500">Loading…</div>
        }
        else if (templates.Count == 0)
        {
            @* Only templates of this request's contract type can merge its values. *@
            <MudAlert Severity="Severity.Warning" Dense="true">
                No approved template exists for the <strong>@contractTypeName</strong> contract type yet.
                One has to be created and approved before this contract can be drafted.
            </MudAlert>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <aside class="lg:col-span-1">
                    <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">
                        Applicable templates
                    </h2>
                    <div class="tpl-list">
                        @foreach (var template in templates)
                        {
                            <button type="button" @onclick="@(() => Select(template))" disabled="@busy"
                                    aria-pressed="@(IsSelected(template) ? "true" : "false")"
                                    class="tpl-item">
                                <span class="tpl-name">@template.Name</span>
                                @if (!string.IsNullOrWhiteSpace(template.Description))
                                {
                                    <span class="tpl-desc">@template.Description</span>
                                }
                            </button>
                        }
                    </div>
                    <p class="text-xs text-slate-500 mt-3">
                        The preview shows this contract with the request's details merged in. Those
                        values are changed on the request, not in the draft.
                    </p>
                </aside>

                <section class="lg:col-span-2">
                    @if (selected is null)
                    {
                        <div class="py-10 text-center text-slate-400">Choose a template to preview it.</div>
                    }
                    else
                    {
                        <div class="flex items-center justify-between mb-3 pb-3 border-b border-slate-200">
                            <div class="min-w-0">
                                <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide truncate">
                                    @selected.Name
                                </h2>
                                <p class="text-xs text-slate-500">nothing has been created yet</p>
                            </div>
                            <MudButton OnClick="@(() => Raise(selected))" Disabled="@(busy || previewing)"
                                       Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Check">
                                @(busy ? "Working…" : "Use this template")
                            </MudButton>
                        </div>

                        @if (previewing)
                        {
                            <div class="py-10 text-center text-slate-500">Building the preview…</div>
                        }
                        else if (string.IsNullOrWhiteSpace(previewHtml))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                This template has no on-screen preview; it is not a rich-text document.
                                It can still be used.
                            </MudAlert>
                        }
                        else
                        {
                            <PagePreview Html="@previewHtml" Class="rounded-xl border border-slate-200" />
                        }
                    }
                </section>
            </div>
        }

        <div class="flex items-center gap-3 pt-4 border-t border-slate-200 mt-4">
            <MudButton Href="/contract-requests" Variant="Variant.Text" Color="Color.Default">Back</MudButton>
        </div>
    </div>
</div>
