@page "/contract-requests"
@layout DashboardLayout
@using zxadocslib.Dtos
@using zxadocslib.Helpers

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between bg-white/90 backdrop-blur-sm">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                <i class="fas fa-file-contract text-sm"></i>
            </div>
            <div>
                <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Contract requests</h1>
                <p class="text-xs text-slate-500">what was awarded, to whom, and on what terms</p>
            </div>
        </div>
        @if (canInitiate)
        {
            <MudButton Href="/contract-requests/new" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                New request
            </MudButton>
        }
    </div>

    <div class="p-6">
        <MudTable Items="@requests" Hover="true" Dense="true" Striped="true" Elevation="0"
                  Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Reference</MudTh>
                <MudTh>Title</MudTh>
                <MudTh>Contract type</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Term</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width:140px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Reference">@context.RequestReference</MudTd>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Contract type">@context.ContractTypeName</MudTd>
                <MudTd DataLabel="Amount">@context.Amount.ToString("N2")</MudTd>
                <MudTd DataLabel="Term">
                    @if (string.IsNullOrWhiteSpace(context.Duration))
                    {
                        <span class="text-slate-400">&mdash;</span>
                    }
                    else
                    {
                        @context.Duration
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@StatusColour(context.Status)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Href="@($"/contract-requests/{context.Id}")" aria-label="Open request" />
                    @if (canDraft && context.Status == ContractRequestStatus.Open)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/contract-requests/{context.Id}/draft")" aria-label="Draft contract" />
                    }
                    @* Hidden once a draft exists rather than offering an action the server refuses. *@
                    @if (canInitiate && context.IsDeletable)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => ConfirmDelete(context))" aria-label="Delete request" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No contract requests yet.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
