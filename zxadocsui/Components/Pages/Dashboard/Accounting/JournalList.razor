@page "/accounting/journals"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-book-open text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Journals</h1>
            <p class="text-xs text-slate-500">posted journals are never edited; corrections are reversals</p>
        </div>
    </div>

    <div class="p-6">
        <MudTable Items="@journals" Hover="true" Dense="true" Elevation="0" Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Number</MudTh><MudTh>Date</MudTh><MudTh>Description</MudTh><MudTh>Source</MudTh>
                <MudTh>Lines</MudTh><MudTh>Posted by</MudTh><MudTh>Reversal</MudTh><MudTh Style="width:60px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Number">@context.Number</MudTd>
                <MudTd DataLabel="Date">@context.Date.ToString("d MMM yyyy")</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
                <MudTd DataLabel="Source">@context.SourceType #@context.SourceId</MudTd>
                <MudTd DataLabel="Lines">
                    @foreach (var line in context.Lines)
                    {
                        <div class="text-xs whitespace-nowrap">
                            @(line.Debit > 0 ? "Dr" : "Cr") @line.AccountCode @line.AccountName
                            <strong>@((line.Debit > 0 ? line.Debit : line.Credit).ToString("N2"))</strong>
                        </div>
                    }
                </MudTd>
                <MudTd DataLabel="Posted by">@context.PostedBy</MudTd>
                <MudTd DataLabel="Reversal">@ReversalText(context)</MudTd>
                <MudTd>
                    @if (canReverse && context.ReversesJournalId is null && context.ReversedByJournalId is null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => Reverse(context))" aria-label="Reverse journal" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No journals yet.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
