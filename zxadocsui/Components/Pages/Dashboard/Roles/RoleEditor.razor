@page "/roles/new"
@page "/roles/{Id:int}"
@layout DashboardLayout

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between bg-white/90 backdrop-blur-sm">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                <i class="fas fa-user-shield text-sm"></i>
            </div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">
                @(IsNew ? "New role" : $"Edit role")
            </h1>
        </div>
    </div>

    <div class="p-6">
        @if (loading)
        {
            <div class="py-10 text-center text-slate-500">Loading…</div>
        }
        else
        {
            <MudForm Model="@model" @ref="form" Validation="@(validator.ValidateValue)" @bind-IsValid="@isValid">
                <section class="mb-6">
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Role</div>
                    <MudTextField T="string" @bind-Value="model.RoleName" For="@(() => model.RoleName)"
                                  Label="Role name" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:420px" />
                </section>

                <section>
                    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Permissions</div>

                    @if (!canSetPermissions)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            You can name this role, but changing what it grants needs the ManageRole permission.
                        </MudAlert>
                    }

                    @if (!selected.Any())
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            This role grants nothing beyond the defaults every role holds.
                        </MudAlert>
                    }

                    @foreach (var group in groups)
                    {
                        <div class="mb-4">
                            <div class="text-sm font-medium text-slate-700 mb-1">@group.Key</div>
                            @foreach (var p in group.Value)
                            {
                                <div>
                                    <MudCheckBox T="bool"
                                                 Value="@IsChecked(p.Value)"
                                                 ValueChanged="@(v => Toggle(p.Value, v))"
                                                 Disabled="@(IsImplicit(p.Value) || !canSetPermissions)"
                                                 Dense="true" Color="Color.Primary"
                                                 Label="@Label(p.Name)" />
                                    @if (IsImplicit(p.Value))
                                    {
                                        @* Inline offset: ml-8 is absent from the committed ctailwindcss.css. *@
                                        <span class="text-xs text-slate-500" style="margin-left:2rem">Held by every role</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>

                <div class="flex items-center gap-3 pt-4 border-t border-slate-200 mt-4">
                    @* Not gated on isValid: MudForm reports false until a field is touched, which
                       would leave Save dead on an edit form the user only changed checkboxes on.
                       Save validates explicitly instead. *@
                    <MudButton OnClick="Save" Disabled="@saving"
                               Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save">
                        @(saving ? "Saving…" : "Save")
                    </MudButton>
                    <MudButton Href="/roles" Variant="Variant.Text" Color="Color.Default">Cancel</MudButton>
                </div>
            </MudForm>
        }
    </div>
</div>
