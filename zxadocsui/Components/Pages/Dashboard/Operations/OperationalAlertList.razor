@page "/operations/alerts"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-bell text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Operational alerts</h1>
            <p class="text-xs text-slate-500">repeats are counted on the open alert; acknowledging closes the alert and leaves its transaction unchanged</p>
        </div>
    </div>

    <div class="p-6 space-y-4">
        <MudSelect T="bool?" Value="open" ValueChanged="Filter" Label="Show" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="max-w-xs">
            <MudSelectItem T="bool?" Value="@((bool?)true)">Open</MudSelectItem>
            <MudSelectItem T="bool?" Value="@((bool?)false)">Acknowledged</MudSelectItem>
        </MudSelect>

        <MudTable Items="@items" Hover="true" Dense="true" Striped="true" Elevation="0" Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Last seen</MudTh><MudTh>Alert</MudTh><MudTh>Reference</MudTh><MudTh>Count</MudTh>
                <MudTh>Message</MudTh><MudTh>Status</MudTh><MudTh Style="width:60px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Last seen">
                    @context.LastSeenAt.ToLocalTime().ToString("d MMM HH:mm")
                    <div class="text-xs text-slate-400">first @context.FirstSeenAt.ToLocalTime().ToString("d MMM HH:mm")</div>
                </MudTd>
                <MudTd DataLabel="Alert">@context.Type</MudTd>
                <MudTd DataLabel="Reference">
                    @context.Reference
                    <div class="text-xs text-slate-400">@context.CorrelationId</div>
                </MudTd>
                <MudTd DataLabel="Count">@context.Count</MudTd>
                <MudTd DataLabel="Message"><span class="text-xs">@context.Message</span></MudTd>
                <MudTd DataLabel="Status">
                    @if (context.AcknowledgedAt is null)
                    {
                        <span>Open</span>
                    }
                    else
                    {
                        <span>Acknowledged</span>
                        <div class="text-xs text-slate-500">by @context.AcknowledgedBy @(context.Note.Length > 0 ? $": {context.Note}" : "")</div>
                    }
                </MudTd>
                <MudTd>
                    @if (context.AcknowledgedAt is null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" OnClick="@(() => Acknowledge(context))" aria-label="Acknowledge" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No alerts.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
