@page "/operations/dead-letters"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-triangle-exclamation text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Dead letters</h1>
            <p class="text-xs text-slate-500">messages that failed every retry; a replay re-sends the same event, which is never applied twice</p>
        </div>
    </div>

    <div class="p-6 space-y-4">
        <MudSelect T="DeadLetterStatus?" Value="status" ValueChanged="Filter" Label="Status" Clearable="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="max-w-xs">
            @foreach (var option in Enum.GetValues<DeadLetterStatus>())
            {
                <MudSelectItem T="DeadLetterStatus?" Value="@option">@option</MudSelectItem>
            }
        </MudSelect>

        <MudTable Items="@items" Hover="true" Dense="true" Striped="true" Elevation="0" Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>When</MudTh><MudTh>Consumer</MudTh><MudTh>Event</MudTh><MudTh>Transaction</MudTh><MudTh>Attempts</MudTh>
                <MudTh>Reason</MudTh><MudTh>Status</MudTh><MudTh Style="width:100px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="When">@context.DeadLetteredAt.ToLocalTime().ToString("d MMM HH:mm")</MudTd>
                <MudTd DataLabel="Consumer">@context.Consumer</MudTd>
                <MudTd DataLabel="Event">
                    <div class="text-xs">@context.Type</div>
                    <div class="text-xs text-slate-400">@(context.EventId?.ToString() ?? "no event id")</div>
                </MudTd>
                <MudTd DataLabel="Transaction">@context.TransactionId</MudTd>
                <MudTd DataLabel="Attempts">@context.Attempts</MudTd>
                <MudTd DataLabel="Reason"><span class="text-xs">@context.Reason</span></MudTd>
                <MudTd DataLabel="Status">
                    @context.Status
                    @if (context.ActionedBy.Length > 0)
                    {
                        <div class="text-xs text-slate-500">by @context.ActionedBy @(context.Note.Length > 0 ? $": {context.Note}" : "")</div>
                    }
                </MudTd>
                <MudTd>
                    @if (context.Status == DeadLetterStatus.Open)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Color="Color.Primary" Disabled="@(context.EventId is null)"
                                       OnClick="@(() => Replay(context))" aria-label="Replay" />
                        <MudIconButton Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" OnClick="@(() => Resolve(context))" aria-label="Resolve" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No dead letters.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
