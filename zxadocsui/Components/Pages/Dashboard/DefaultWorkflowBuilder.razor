@using zxadocsfe.Dtos
@using zxadocsfe.Services
@using zxadocslib.Dtos
@using zxadocsui.Srevices

<p class="text-sm text-slate-500 mb-3">Levels run in the order shown. The last level closes the workflow.</p>

@for (var i = 0; i < levels.Count; i++)
{
    var index = i;
    var level = levels[index];

    <div @key="level" class="rounded-xl border border-slate-200 p-3 mb-3">
        <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-500">LEVEL @(index + 1)</span>
            <div class="flex items-center">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                               Disabled="@(index == 0)" OnClick="@(() => MoveUp(index))" />
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                               Disabled="@(index == levels.Count - 1)" OnClick="@(() => MoveDown(index))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               Disabled="@(levels.Count == 1)" OnClick="@(() => Remove(index))" />
            </div>
        </div>

        <MudSelect T="int" @bind-Value="level.RoleId" Label="User Role" Placeholder="Select role"
                   Variant="Variant.Outlined">
            @foreach (var role in userRoles)
            {
                <MudSelectItem T="int" Value="@role.RoleId">@role.RoleName</MudSelectItem>
            }
        </MudSelect>
        <MudSwitch @bind-Value="level.IsRequired" Color="Color.Primary" Label="Required" />
    </div>
}

<MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium" FullWidth="true"
           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddLevel())">Add level
</MudButton>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" FullWidth="true"
           OnClick="@(() => Save())" class="mt-3">Save workflow
</MudButton>

@code {

    [Inject] ISnackbar Snackbar { set; get; } = default!;
    [Inject] ILogger<DefaultWorkflowBuilder> logger { set; get; } = default!;
    [Inject] SideDialogService sideDialog { set; get; } = default!;
    [Inject] IHttpService httpSvc { get; set; } = default!;

    private List<UserRole> userRoles = new();
    private List<WorkFlow> levels = new() { new WorkFlow() };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender)
                return;

            await loadUserRoles();
            StateHasChanged();
        }
        catch (Exception ee)
        {
            logger!.LogError(ee, ee.Message);
        }
    }

    private async Task loadUserRoles()
    {
        try
        {
            var (status, result, message) = await httpSvc!.GetAsync<ApiResponse<List<UserRole>>>("api/userroles");
            if (status == false || result?.Data == null)
            {
                // Silence here left an empty dropdown that read as "no roles exist".
                Snackbar.Add(string.IsNullOrEmpty(message) ? "Couldn't load the roles" : message, Severity.Error);
                return;
            }

            userRoles = result.Data;
            userRoles.Insert(0, new UserRole { RoleId = 0, RoleName = "Select" });
        }
        catch (Exception ex)
        {
            logger!.LogDebug(ex.Message);
        }
    }

    void AddLevel() => levels.Add(new WorkFlow());

    void Remove(int index)
    {
        if (levels.Count == 1)
            return;
        levels.RemoveAt(index);
    }

    void MoveUp(int index)
    {
        if (index <= 0) return;
        (levels[index - 1], levels[index]) = (levels[index], levels[index - 1]);
    }

    void MoveDown(int index)
    {
        if (index < 0 || index >= levels.Count - 1) return;
        (levels[index + 1], levels[index]) = (levels[index], levels[index + 1]);
    }

    /// <summary>Numbers the levels from their order on screen and hands the chain back to the page.</summary>
    void Save()
    {
        Snackbar.Clear();

        if (levels.Any(level => level.RoleId == 0))
        {
            Snackbar.Add("Every level needs a role", Severity.Error);
            return;
        }

        if (levels.GroupBy(level => level.RoleId).Any(group => group.Count() > 1))
        {
            Snackbar.Add("A role can only appear once in a workflow", Severity.Error);
            return;
        }

        for (var i = 0; i < levels.Count; i++)
        {
            levels[i].Level = i + 1;
            levels[i].RoleName = userRoles.FirstOrDefault(role => role.RoleId == levels[i].RoleId)?.RoleName ?? "";
            levels[i].IsFinal = i == levels.Count - 1;
        }

        sideDialog.Close(levels);
    }
}
