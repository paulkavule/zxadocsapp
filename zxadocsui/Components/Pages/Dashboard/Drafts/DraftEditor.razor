@page "/drafts/new/{TemplateId:int}"
@page "/drafts/{Id:int}/edit"
@layout DashboardLayout

@* LAYOUT SCAFFOLD (ZD-21 / FR-F5) — static placeholders, no data wiring yet. *@

<div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- dynamic field form -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
            <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                <i class="fas fa-pen-to-square text-sm"></i>
            </div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Draft contract</h1>
        </div>
        <div class="p-6 space-y-4">
            <MudTextField T="string" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <div class="border-t border-slate-100 pt-4 space-y-4">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Fields (generated per template)</p>
                <MudTextField T="string" Label="Party name" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                <MudDatePicker Label="Effective date" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="string" Label="Jurisdiction" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Uganda")">Uganda</MudSelectItem>
                    <MudSelectItem Value="@("Kenya")">Kenya</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" Label="Recitals" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudCheckBox T="bool" Label="Auto-renew" />
            </div>
            <div class="flex items-center gap-2 pt-4 border-t border-slate-200">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">Save draft</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility">Preview</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send">Submit</MudButton>
            </div>
            <p class="text-xs text-slate-400">Template: <code>@TemplateId</code> · Draft: <code>@Id</code></p>
        </div>
    </div>

    <!-- preview -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 p-5 flex flex-col">
        <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Live preview</h2>
        <div class="flex-1 min-h-[520px] rounded-xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400">
            <div class="text-center">
                <i class="fas fa-file-pdf text-3xl mb-2"></i>
                <p>Preview rendered from the filled template</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public int Id { get; set; }
}
