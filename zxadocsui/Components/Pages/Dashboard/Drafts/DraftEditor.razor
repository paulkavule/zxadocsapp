@page "/drafts/new/{TemplateId:int}"
@page "/drafts/{Id:int}/edit"
@layout DashboardLayout
@using zxadocslib.Dtos
@using zxadocslib.Helpers

<div class="draft-editor w-full grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- form -->
    <div class="pane bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden flex flex-col">
        <div class="pane-head px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90">
            <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                <i class="fas fa-pen-to-square text-sm"></i>
            </div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Draft contract</h1>
        </div>

        @if (version is null)
        {
            <div class="p-6 text-slate-500">@(loadError ?? "Loading…")</div>
        }
        else
        {
            <div class="pane-body p-6 space-y-4">
                <MudTextField @bind-Value="title" Label="Title" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />

                <div class="border-t border-slate-100 pt-4 space-y-4">
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Fields</p>
                    @if (FieldsAreReadOnly)
                    {
                        @* Owned by the initiation request (ZD-121): a wrong value is corrected
                           there, so the contract can never say something the request does not. *@
                        <MudAlert Severity="Severity.Info" Dense="true">
                            These come from the contract request.
                            <MudLink Href="@($"/contract-requests/{contractRequestId}")">Open the request</MudLink>
                            to change them.
                        </MudAlert>
                    }
                    @foreach (var f in version.Fields.OrderBy(f => f.Order))
                    {
                        <div>
                            @switch (f.FieldType)
                            {
                                case TemplateFieldType.MultilineText:
                                    <MudTextField T="string" Label="@f.Label" Value="@Get(f.Id)" ValueChanged="@(v => Set(f.Id, v))" Immediate="true" Lines="3" Required="f.IsRequired" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@FieldsAreReadOnly" />
                                    break;
                                case TemplateFieldType.Number:
                                case TemplateFieldType.Currency:
                                    <MudTextField T="string" Label="@f.Label" Value="@Get(f.Id)" ValueChanged="@(v => Set(f.Id, v))" Immediate="true" InputType="InputType.Number" Required="f.IsRequired" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@FieldsAreReadOnly" />
                                    break;
                                case TemplateFieldType.Date:
                                    <MudDatePicker Label="@f.Label" Date="@GetDate(f.Id)" DateChanged="@(d => SetDate(f.Id, d))" Required="f.IsRequired" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@FieldsAreReadOnly" />
                                    break;
                                case TemplateFieldType.Boolean:
                                    <MudCheckBox T="bool" Label="@f.Label" Value="@GetBool(f.Id)" ValueChanged="@(v => SetBool(f.Id, v))" Disabled="@FieldsAreReadOnly" />
                                    break;
                                case TemplateFieldType.Dropdown:
                                    <MudSelect T="string" Label="@f.Label" Value="@Get(f.Id)" ValueChanged="@(v => Set(f.Id, v))" Required="f.IsRequired" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@FieldsAreReadOnly">
                                        @foreach (var opt in f.Options)
                                        {
                                            <MudSelectItem Value="@opt">@opt</MudSelectItem>
                                        }
                                    </MudSelect>
                                    break;
                                default:
                                    <MudTextField T="string" Label="@f.Label" Value="@Get(f.Id)" ValueChanged="@(v => Set(f.Id, v))" Immediate="true" Required="f.IsRequired" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@FieldsAreReadOnly" />
                                    break;
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="pane-foot flex items-center gap-2 px-6 py-4 border-t border-slate-200 bg-white/90">
                <MudButton OnClick="SaveDraft" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" StartIcon="@Icons.Material.Filled.Save">Save draft</MudButton>
                <MudButton OnClick="SubmitDraft" Variant="Variant.Text" Color="Color.Primary" Disabled="@(busy || draftId == 0)" StartIcon="@Icons.Material.Filled.Send">Submit</MudButton>
            </div>
        }
    </div>

    <!-- live preview: template body with the current values merged in, updates as you edit -->
    <div class="pane lg:col-span-2 bg-white rounded-2xl shadow-xl border border-slate-200 p-5 flex flex-col">
        <h2 class="pane-head text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">
            Live preview
            <span class="normal-case font-normal text-slate-400">— unfilled fields are highlighted</span>
        </h2>
        @if (version is not null && !string.IsNullOrEmpty(templateHtml))
        {
            <PagePreview Html="@BuildPreview()" Class="rounded-xl border border-slate-200" />
        }
        else
        {
            <div class="preview-placeholder rounded-xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400">
                <div class="text-center"><i class="fas fa-file-lines text-3xl mb-2"></i><p>@(loadError ?? "Loading template…")</p></div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int TemplateId { get; set; }
    [Parameter] public int Id { get; set; }
}
