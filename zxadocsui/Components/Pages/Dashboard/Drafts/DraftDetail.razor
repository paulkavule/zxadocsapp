@page "/drafts/{Id:int}"
@layout DashboardLayout
@using zxadocslib.Dtos
@using zxadocslib.Helpers

@if (draft is null)
{
    <div class="py-20 text-center text-slate-500">@(loadError ?? "Loading…")</div>
}
else
{
    <div class="draft-detail w-full flex flex-col gap-6">
        <div class="detail-head bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between bg-white/90">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                        <i class="fas fa-file-signature text-sm"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-semibold text-slate-800 tracking-tight">@draft.Title</h1>
                        <p class="text-xs text-slate-500">draft #@draft.Id</p>
                    </div>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(draft.Status)" Variant="Variant.Filled">@Label(draft.Status)</MudChip>
                </div>
                <div class="flex items-center gap-2">
                    @if (canManage && (draft.Status == DraftStatus.Draft || draft.Status == DraftStatus.Rejected))
                    {
                        <MudButton Href="@($"/drafts/{draft.Id}/edit")" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                        <MudButton OnClick="Submit" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="busy">Submit</MudButton>
                    }
                    @if (canApprove && draft.Status == DraftStatus.PendingApproval)
                    {
                        <MudButton OnClick="Approve" Variant="Variant.Text" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="busy">Approve</MudButton>
                        <MudButton OnClick="Reject" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" Disabled="busy">Reject</MudButton>
                    }
                    @if (draft.Status == DraftStatus.Approved || draft.Status == DraftStatus.SentToWorkflow)
                    {
                        <MudButton OnClick="Download" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Disabled="busy">Download</MudButton>
                    }
                    @if (canManage && draft.Status == DraftStatus.Approved)
                    {
                        <MudButton OnClick="StartSigning" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel" Disabled="busy">Start signing workflow</MudButton>
                    }
                </div>
            </div>
            @if (draft.Status == DraftStatus.SentToWorkflow)
            {
                <div class="px-6 py-3 text-sm text-slate-600 bg-green-50 border-t border-green-100">
                    Sent to the signing workflow · reference <code>@draft.DocumentReference</code>
                </div>
            }
        </div>

        <div class="detail-grid grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="pane lg:col-span-1 bg-white rounded-2xl shadow-xl border border-slate-200 p-5 flex flex-col">
                <h2 class="pane-head text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Field values</h2>
                <ul class="pane-body space-y-2 text-sm">
                    @foreach (var v in draft.FieldValues)
                    {
                        <li class="flex justify-between gap-3">
                            <span class="text-slate-500">@FieldLabel(v.TemplateFieldId)</span>
                            <span class="text-slate-800 text-right">@v.Value</span>
                        </li>
                    }
                </ul>
            </div>
            <div class="pane lg:col-span-2 bg-white rounded-2xl shadow-xl border border-slate-200 p-5 flex flex-col">
                <h2 class="pane-head text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Preview</h2>
                @if (version is not null && !string.IsNullOrEmpty(templateHtml))
                {
                    <PagePreview Html="@BuildPreview()" Class="rounded-xl border border-slate-200" />
                }
                else
                {
                    <div class="preview-placeholder rounded-xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400">
                        <div class="text-center"><i class="fas fa-file-lines text-3xl mb-2"></i><p>@(loadError ?? "Loading preview…")</p></div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
}
