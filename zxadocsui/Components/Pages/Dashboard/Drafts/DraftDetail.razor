@page "/drafts/{Id:int}"
@layout DashboardLayout

@* LAYOUT SCAFFOLD (ZD-23 / FR-F7) — static placeholders, no data wiring yet. *@

<div class="w-full space-y-6">
    <!-- header -->
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between bg-white/90">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                    <i class="fas fa-file-signature text-sm"></i>
                </div>
                <div>
                    <h1 class="text-xl font-semibold text-slate-800 tracking-tight">ACME NDA</h1>
                    <p class="text-xs text-slate-500">from “Mutual NDA” · draft #@Id</p>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Approved</MudChip>
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send">Submit</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download">Download</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel">Start signing workflow</MudButton>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- values -->
        <div class="lg:col-span-1 bg-white rounded-2xl shadow-xl border border-slate-200 p-5">
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Field values</h2>
            <ul class="space-y-2 text-sm">
                <li class="flex justify-between"><span class="text-slate-500">Party name</span><span class="text-slate-800">Acme Ltd</span></li>
                <li class="flex justify-between"><span class="text-slate-500">Effective date</span><span class="text-slate-800">05 Jul 2026</span></li>
                <li class="flex justify-between"><span class="text-slate-500">Jurisdiction</span><span class="text-slate-800">Uganda</span></li>
            </ul>
        </div>
        <!-- preview -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-xl border border-slate-200 p-5">
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Preview</h2>
            <div class="h-[520px] rounded-xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400">
                <div class="text-center">
                    <i class="fas fa-file-pdf text-3xl mb-2"></i>
                    <p>Generated document preview</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
}
