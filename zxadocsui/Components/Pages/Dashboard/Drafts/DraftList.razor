@page "/drafts"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between bg-white/90 backdrop-blur-sm">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                <i class="fas fa-pen-to-square text-sm"></i>
            </div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Drafts</h1>
        </div>
        <MudButton Href="/templates" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.LibraryBooks">
            Start from a template
        </MudButton>
    </div>

    <div class="p-6">
        <div class="flex flex-wrap items-center gap-3 mb-4">
            <MudSelect T="int" Value="statusFilter" ValueChanged="OnStatusChanged" Label="Status"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:190px">
                <MudSelectItem Value="-1">All statuses</MudSelectItem>
                <MudSelectItem Value="0">Draft</MudSelectItem>
                <MudSelectItem Value="1">Pending approval</MudSelectItem>
                <MudSelectItem Value="2">Approved</MudSelectItem>
                <MudSelectItem Value="3">Rejected</MudSelectItem>
                <MudSelectItem Value="4">Sent to workflow</MudSelectItem>
            </MudSelect>
        </div>

        <MudTable @ref="table" T="DraftDto" ServerData="LoadData" Hover="true" Dense="true" Striped="true"
                  Elevation="0" OnRowClick="Open" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)" Variant="Variant.Filled">
                        @Label(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">
                    No drafts yet. Start one from an approved template.
                </div>
            </NoRecordsContent>
            <LoadingContent>
                <div class="py-10 text-center text-slate-500">Loading drafts…</div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
            </PagerContent>
        </MudTable>
    </div>
</div>
