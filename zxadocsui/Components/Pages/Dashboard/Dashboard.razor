@page "/dashboard"
@rendermode InteractiveServer
<!-- page title + breadcrumb -->
<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-bold text-slate-800 tracking-tight">Document workflows</h1>
        <nav class="flex items-center space-x-2 text-sm text-slate-500 mt-1">
            <a href="#" class="hover:text-green-600">Dashboard</a>
            <i class="fa-solid fa-chevron-right text-xs"></i>
            <span class="text-slate-800 font-medium">Active workflows</span>
        </nav>
    </div>
    <div class="flex items-center gap-3 text-sm">
        <span
            class="bg-green-100 text-green-700 px-3 py-1.5 rounded-full flex items-center gap-1.5 text-xs font-semibold">
            <i class="fa-solid fa-circle-check"></i> System online · 2 min lag
        </span>
    </div>
</div>
<!-- STATS CARDS (4 backoffice kpi) -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-sm text-slate-500 font-medium">Pending approval</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@statistics.Pending</p>
            </div>
            <div class="bg-amber-100 w-12 h-12 rounded-xl flex items-center justify-center text-amber-600">
                <i class="fa-regular fa-clock text-xl"></i>
            </div>
        </div>
        <p class="text-xs text-slate-400 mt-4"><span class="text-green-600 font-medium">↑ 3</span> since yesterday</p>
    </div>
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-sm text-slate-500 font-medium">In review</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@statistics.InReview</p>
            </div>
            <div class="bg-blue-100 w-12 h-12 rounded-xl flex items-center justify-center text-blue-600">
                <i class="fa-regular fa-file-lines text-xl"></i>
            </div>
        </div>
        <p class="text-xs text-slate-400 mt-4">2 due today</p>
    </div>
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-sm text-slate-500 font-medium">Completed (this week)</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@statistics.Completed</p>
            </div>
            <div class="bg-emerald-100 w-12 h-12 rounded-xl flex items-center justify-center text-emerald-600">
                <i class="fa-regular fa-circle-check text-xl"></i>
            </div>
        </div>
        <p class="text-xs text-slate-400 mt-4"><span class="text-green-600 font-medium">+12%</span> vs last week</p>
    </div>
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm stat-card">
        <div class="flex items-start justify-between">
            <div>
                <p class="text-sm text-slate-500 font-medium">Avg. resolution</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@statistics.AverageResolution</p>
            </div>
            <div class="bg-green-100 w-12 h-12 rounded-xl flex items-center justify-center text-green-600">
                <i class="fa-solid fa-gauge-high text-xl"></i>
            </div>
        </div>
        <p class="text-xs text-slate-400 mt-4">-32 min from last month</p>
    </div>
</div>
<!-- two column layout: active workflows table + right side info -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- LEFT: approval aging (span 2). Diverging around "due today": overdue left, upcoming
         right. Replaces the placeholder active-workflows table. -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
            <h2 class="font-semibold text-slate-800 text-lg flex items-center gap-2"><i
                class="fa-regular fa-hourglass-half text-green-500"></i> Approval aging</h2>
            <button type="button" @onclick="ViewAllPendingApprovals"
                    class="text-sm text-green-600 hover:underline flex items-center gap-1">
                View all <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <div class="p-6">
            @if (pendingApprovals.Count == 0)
            {
                <p class="text-sm text-slate-500">Nothing is waiting on you.</p>
            }
            else
            {
                var buckets = AgingBuckets();
                var scale = AgingScale(buckets);

                <div class="flex items-center gap-4 mb-4 text-xs text-slate-500">
                    <span class="flex items-center gap-1">
                        <span style="width:10px;height:10px;border-radius:2px;background:@OverdueColor"></span> Overdue
                    </span>
                    <span class="flex items-center gap-1">
                        <span style="width:10px;height:10px;border-radius:2px;background:@DueTodayColor"></span> Due today
                    </span>
                    <span class="flex items-center gap-1">
                        <span style="width:10px;height:10px;border-radius:2px;background:@UpcomingColor"></span> Upcoming
                    </span>
                </div>

                <div class="flex flex-col gap-2">
                    @foreach (var bucket in buckets)
                    {
                        <div class="flex items-center text-sm">
                            <span class="text-slate-600 text-right" style="width:150px;flex:none">@bucket.Label</span>

                            @* Two half-tracks meeting at a centre rule: the left half fills
                               right-to-left for overdue, the right half fills left-to-right. *@
                            @* justify-content inline: justify-end is absent from the committed
                               ctailwindcss.css, and without it the overdue bars would drift off
                               the centre rule. *@
                            <span style="display:flex;justify-content:flex-end;flex:1 1 0;min-width:0">
                                @if (bucket.Side < 0 && bucket.Count > 0)
                                {
                                    <span title="@bucket.Label: @bucket.Count"
                                          style="height:18px;border-radius:4px 0 0 4px;background:@bucket.Color;width:@(Pct(bucket.Count, scale))%"></span>
                                }
                            </span>
                            <span style="width:1px;height:24px;background:#c3c2b7;flex:none"></span>
                            <span class="flex" style="flex:1 1 0;min-width:0">
                                @if (bucket.Side >= 0 && bucket.Count > 0)
                                {
                                    <span title="@bucket.Label: @bucket.Count"
                                          style="height:18px;border-radius:0 4px 4px 0;background:@bucket.Color;width:@(Pct(bucket.Count, scale))%"></span>
                                }
                            </span>

                            <span class="text-slate-800 font-medium" style="width:32px;flex:none;text-align:right">
                                @(bucket.Count == 0 ? "" : bucket.Count.ToString())
                            </span>
                        </div>
                    }
                </div>

                @if (UndatedApprovals > 0)
                {
                    <p class="text-xs text-slate-500 mt-3">
                        @UndatedApprovals not shown - no due date set.
                    </p>
                }
            }
        </div>
    </div>
            <!-- RIGHT: activity feed and pending tasks -->
            <div class="space-y-6">
                <!-- pending approvals card (compact) -->
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                    <h3 class="font-semibold text-slate-800 flex items-center gap-2 mb-4"><i
                        class="fa-regular fa-bell text-amber-500"></i> Your pending approvals</h3>
                        @if (pendingApprovals.Count == 0)
                        {
                            <p class="text-sm text-slate-500">Nothing is waiting on you.</p>
                        }
                        else
                        {
                            <ul class="space-y-3">
                                @foreach (var doc in pendingApprovals.Take(PendingApprovalsShown))
                                {
                                    var due = DueLabel(doc.DueDate);
                                    <li class="flex items-center justify-between text-sm gap-2">
                                        <button type="button" @onclick="@(() => OpenDocument(doc.RecordId))"
                                                class="flex items-center gap-2 text-left hover:underline"
                                                title="@doc.Title">
                                            <i class="fa-regular fa-file-lines text-slate-400"></i>
                                            <span class="text-slate-700">@doc.Title</span>
                                        </button>
                                        @if (due.Urgent)
                                        {
                                            <span class="bg-amber-100 text-amber-700 font-bold px-2 rounded-full"
                                                  style="font-size:10px;padding-top:2px;padding-bottom:2px">@due.Text</span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">@due.Text</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        <button type="button" @onclick="ViewAllPendingApprovals"
                            class="w-full mt-4 text-green-600 text-sm font-medium border border-green-200 rounded-xl py-2.5 hover:bg-green-50 transition">
                            View all @pendingApprovals.Count
                        </button>
                        </div>
                        <!-- action mix: what happened each day for the last week, broken down by
                             action. Replaces the volume-only "workflow velocity" bars. -->
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="font-semibold text-slate-800">Action mix</h3>
                                <span class="text-xs text-slate-500">last 7 days</span>
                            </div>

                            @if (actionMix.Count == 0)
                            {
                                <p class="text-sm text-slate-500">No activity in the last 7 days.</p>
                            }
                            else
                            {
                                var max = ActionMixMax;
                                <div class="flex items-end gap-2" style="height:96px">
                                    @foreach (var day in actionMix)
                                    {
                                        var total = day.Counts.Values.Sum();
                                        <div class="flex flex-col justify-end" style="flex:1 1 0"
                                             title="@day.Day.ToString("ddd d MMM"): @total action(s)">
                                            @* Stacked top-down so the tallest segment sits at the
                                               base; 2px surface gaps keep segments separable. *@
                                            @foreach (var series in ActionSeries.Reverse())
                                            {
                                                var count = day.Counts[series.Label];
                                                @if (count > 0)
                                                {
                                                    <span title="@series.Label on @day.Day.ToString("ddd d MMM"): @count"
                                                          style="display:block;background:@series.Color;height:@(Pct(count, max))%;min-height:3px;margin-bottom:2px;border-radius:2px"></span>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="flex gap-2 text-xs text-slate-500 mt-2">
                                    @foreach (var day in actionMix)
                                    {
                                        <span class="text-center" style="flex:1 1 0">@day.Day.ToString("ddd")[..1]</span>
                                    }
                                </div>

                                <hr class="my-4 border-slate-100">
                                <div class="flex flex-wrap gap-3 text-xs text-slate-500">
                                    @foreach (var series in ActionSeries)
                                    {
                                        <span class="flex items-center gap-1">
                                            <span style="width:10px;height:10px;border-radius:2px;background:@series.Color"></span>
                                            @series.Label
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        <!-- recent audit log snippet -->
                        <div class="bg-white/70 rounded-2xl border border-slate-200 p-5">
                            <h3 class="font-semibold text-slate-800 text-sm flex items-center gap-2"><i
                                class="fa-regular fa-clock text-green-500"></i> Recent activity</h3>
                                <div class="mt-3 space-y-2 text-xs">
                                    @foreach (var item in listValues)
                                    {
                                        <div>@item.Value</div>
                                    }

                                </div>
                                @if (canReports)
                                {
                                    <NavLink href="/reports/activity" class="block mt-3 text-green-600 text-xs hover:underline">View full audit trail →</NavLink>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- bottom action bar (quick actions) -->
                    <div class="mt-8 bg-green-50/70 border border-green-100 rounded-2xl p-5 flex flex-wrap items-center justify-between">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-wand-magic-sparkles text-green-600 text-xl"></i>
                            <span class="font-medium text-slate-800">Need to create a new approval flow?</span>
                        </div>
                        <div class="flex gap-3">
                            <button
                                class="bg-white border border-green-200 text-green-700 px-5 py-2 rounded-xl text-sm font-medium hover:bg-green-50 transition flex items-center gap-2"><i
                                class="fa-regular fa-file"></i> Use template</button>
                                <button
                                    class="bg-green-600 text-white px-5 py-2 rounded-xl text-sm font-medium shadow-sm hover:bg-green-700 transition flex items-center gap-2"><i
                                    class="fa-solid fa-plus"></i> Custom workflow</button>
                                </div>
                            </div>