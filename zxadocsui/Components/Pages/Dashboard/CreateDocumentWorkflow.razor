@page "/workflows"

@using zxadocsfe.Dtos
@using zxadocslib.Helpers

<div class="flex  justify-between items-center gap-4 mb-3">
    <div class="flex-1 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <p class="text-sm text-slate-500">Categories</p>
        <p class="text-2xl font-semibold mt-1">5</p>
    </div>
    <div class="flex-1 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <p class="text-sm text-slate-500">Active Workflows</p>
        <p class="text-2xl font-semibold mt-1">12</p>
    </div>
    <div class="flex-1 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <p class="text-sm text-slate-500">Approval Levels</p>
        <p class="text-2xl font-semibold mt-1">28</p>
    </div>
</div>
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h2 class="text-lg font-semibold text-slate-900">Workflow Listing</h2>
            <p class="text-sm text-slate-500 mt-1">Approval flows grouped by document category.</p>
        </div>
        <div class="flex gap-3">
            <MudSelect T="string" ValueChanged="DocTypeChanged" Label="Document Type" Placeholder="Document Type"
                       Variant="Variant.Outlined" Required="true" RequiredError="Select the document type">
                @foreach (var item in doctypeList)
                {
                    <MudSelectItem Value="item.Id.ToString()">@item.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" ValueChanged="DocCatChanged" Label="Document category" Placeholder="Document Category"
                       Variant="Variant.Outlined" Required="true" RequiredError="Select the document category">
                @foreach (var item in docCatList)
                {
                    <MudSelectItem Value="item.Id.ToString()">@item.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    <div class="divide-y divide-slate-200">
        <article class="p-5">
            <div class="flex flex-col xl:flex-row xl:items-start xl:justify-between gap-4">
                <div>
                    @if (CategorySelected)
                    {
                        <div class="flex items-center gap-3">
                            <span
                            class="inline-flex items-center rounded-full bg-indigo-50 text-indigo-700 px-3 py-1 text-xs font-medium">@docTypeName</span>
                            @if (workflowList.Count > 0)
                            {
                                <span
                                class="inline-flex items-center rounded-full bg-emerald-50 text-emerald-700 px-3 py-1 text-xs font-medium">@workflowList.Count
                                    @(workflowList.Count == 1 ? "level" : "levels")</span>
                            }
                            else
                            {
                                <span
                                class="inline-flex items-center rounded-full bg-amber-50 text-amber-700 px-3 py-1 text-xs font-medium">No
                                    levels</span>
                            }
                        </div>
                        <h3 class="text-base font-semibold text-slate-900 mt-3">@docCategoryName</h3>
                        <p class="text-sm text-slate-500 mt-1">The approval chain every @docCategoryName document
                            follows, in order.</p>
                    }
                    else
                    {
                        <h3 class="text-base font-semibold text-slate-900">Select a document type and category</h3>
                        <p class="text-sm text-slate-500 mt-1">Choose both above to see the approval chain, or to define
                            one.</p>
                    }
                </div>
                @if (CategorySelected && workflowList.Count > 0)
                {
                    <div class="flex gap-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!canCreateWorkflow)"
                                   OnClick="@(()=>AddStepToCategory())">Add
                        </MudButton>
                        @if (rearranged)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                       OnClick="@(()=>SaveLevelChanges())"
                                       Disabled="@(updating || !canManageWorkflow)">save
                            </MudButton>
                        }
                    </div>
                }
            </div>

            <!-- Approval Timeline -->
            @if (workflowList.Count > 0)
            {
                <div class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-4 overflow-y-auto">
                    @foreach (var wf in workflowList)
                    {
                        <div class="relative rounded-xl border border-slate-200 bg-white p-4">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold text-blue-400 hover:cursor-pointer"
                                      @onclick="()=>EditDocWorkflow(wf)">LEVEL
                                    @wf.Level</span>
                                <div class="flex justify-between items-center gap-2">
                                    <span class="text-sm text-slate-500">@(wf.IsRequired ? "Required":"Optional")</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                   Disabled="@(!canManageWorkflow)" />
                                </div>
                            </div>

                            <div class="flex justify-between items-center mt-3">
                                <p class="font-medium text-slate-900">@wf.RoleName</p>
                                <div>
                                    <button class="p-2 rounded-full bg-gray-600 hover:bg-gray-400"
                                            @onclick="() => MoveUp(wf)"><i class="fa fa-angle-left" aria-hidden="true"></i></button>
                                    <button class="p-2 rounded-full bg-gray-600 hover:bg-gray-400"
                                            @onclick="() => MoveDown(wf)"><i class="fa fa-angle-right"
                                                                         aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (CategorySelected)
            {
                <div class="mt-5 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
                    <p class="text-sm font-medium text-slate-900">No workflow defined for this category</p>
                    <p class="text-sm text-slate-500 mt-1">Define the whole chain at once, or add one level at a time.</p>
                    <div class="flex justify-center gap-3 mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(saving || !canCreateWorkflow)"
                                   OnClick="@(()=>CreateDefaultWorkflow())">Create default workflow
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!canCreateWorkflow)"
                                   OnClick="@(()=>AddStepToCategory())">Add step
                        </MudButton>
                    </div>
                </div>
            }
        </article>

        @if (CategorySelected)
        {
            <article class="p-5">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <h3 class="text-base font-semibold text-slate-900">Category fields</h3>
                        <p class="text-sm text-slate-500 mt-1">Collected from the author when a
                            @(string.IsNullOrEmpty(docCategoryName) ? "document" : docCategoryName) is initiated.</p>
                    </div>
                    @if (canManage)
                    {
                        <MudButton OnClick="AddField" Variant="Variant.Outlined" Color="Color.Primary"
                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">Add field</MudButton>
                    }
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm border border-slate-200 rounded-xl overflow-hidden">
                        <thead class="bg-slate-50 text-slate-500">
                            <tr class="text-left">
                                <th class="px-3 py-2 font-medium w-[26%]">Name</th>
                                <th class="px-3 py-2 font-medium w-[18%]">Type</th>
                                <th class="px-3 py-2 font-medium w-[34%]">Options (Dropdown)</th>
                                <th class="px-3 py-2 font-medium w-[10%] text-center">Required</th>
                                <th class="px-3 py-2 font-medium w-[12%]"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (categoryFields.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="px-3 py-6 text-center text-slate-400">
                                        No extra fields. An author initiating this category fills in nothing beyond the basics.
                                    </td>
                                </tr>
                            }
                            @foreach (var field in categoryFields)
                            {
                                <tr class="border-t border-slate-100 align-top">
                                    <td class="px-2 py-1">
                                        <MudTextField @bind-Value="field.Name" Placeholder="Cost centre" Variant="Variant.Text"
                                                      Margin="Margin.Dense" Disabled="@(!canManage)" />
                                    </td>
                                    <td class="px-2 py-1">
                                        <MudSelect T="TemplateFieldType" @bind-Value="field.Type" Variant="Variant.Text"
                                                   Margin="Margin.Dense" Disabled="@(!canManage)">
                                            @foreach (var type in FieldTypes)
                                            {
                                                <MudSelectItem Value="type">@type</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </td>
                                    <td class="px-2 py-1">
                                        <MudTextField @bind-Value="field.OptionsCsv" Placeholder="North, South, Central"
                                                      Disabled="@(!canManage || field.Type != TemplateFieldType.Dropdown)"
                                                      Variant="Variant.Text" Margin="Margin.Dense" />
                                    </td>
                                    <td class="px-2 py-1 text-center">
                                        <MudCheckBox @bind-Value="field.Required" Disabled="@(!canManage)" />
                                    </td>
                                    <td class="px-2 py-1 text-right">
                                        @if (canManage)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                           Disabled="@(categoryFields.IndexOf(field) == 0)"
                                                           OnClick="@(() => MoveField(field, -1))" aria-label="Move field up" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                           Color="Color.Error" OnClick="@(() => RemoveField(field))"
                                                           aria-label="Remove field" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (canManage)
                {
                    <div class="flex items-center gap-3 mt-4">
                        <MudButton OnClick="SaveFields" Disabled="@savingFields" Variant="Variant.Filled"
                                   Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">
                            @(savingFields ? "Saving..." : "Save fields")
                        </MudButton>
                        <span class="text-xs text-slate-500">A removed field stops being collected; values already
                            captured on existing documents are kept.</span>
                    </div>
                }
            </article>
        }
    </div>
</div>
