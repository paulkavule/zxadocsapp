@page "/settings/organisations/new"
@page "/settings/organisations/{EntityId}"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden max-w-4xl">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90 backdrop-blur-sm">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-building text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">
                @(IsNew ? "New organisation" : "Edit organisation")
            </h1>
            <p class="text-xs text-slate-500">
                @(IsNew
                    ? "Admin, Approver and Super User roles are created with it"
                    : "the tenant's own details")
            </p>
        </div>
    </div>

    <div class="p-6">
        @if (loading)
        {
            <div class="py-10 text-center text-slate-500">Loading…</div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <MudTextField @bind-Value="organisation.Name" Label="Name" Immediate="true"
                              Placeholder="Kampala Widgets" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="organisation.Email" Label="Email"
                              Placeholder="admin@example.com" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="organisation.PhoneNumber" Label="Phone number"
                              Placeholder="700000000" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="organisation.Website" Label="Website"
                              Placeholder="example.com" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="organisation.Address" Label="Address" Lines="2"
                              Placeholder="Plot 1, Kampala" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-slate-200 mt-4">
                <MudButton OnClick="Save" Disabled="@saving" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save">
                    @(saving ? "Saving…" : "Save")
                </MudButton>
                <MudButton Href="/settings/organisations" Variant="Variant.Text" Color="Color.Default">Cancel</MudButton>
            </div>
        }
    </div>
</div>
