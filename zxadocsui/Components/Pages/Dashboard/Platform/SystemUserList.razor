@page "/settings/system-users"
@layout DashboardLayout
@using zxadocslib.Dtos

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden max-w-4xl">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90 backdrop-blur-sm">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-user-shield text-sm"></i>
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">System users</h1>
            <p class="text-xs text-slate-500">the accounts that administer this platform</p>
        </div>
    </div>

    <div class="p-6 space-y-4">
        @* Read only for now: CreateUser pins the caller's own organisation and a role carrying a
           SystemRole is deliberately not grantable through a user request (ZD-129). Provisioning
           another system user needs API work of its own. *@
        <MudAlert Severity="Severity.Info" Dense="true">
            System users cannot be created from here yet. The first one is provisioned at startup.
        </MudAlert>

        <MudTable Items="@users" Hover="true" Dense="true" Striped="true" Elevation="0"
                  Loading="@loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Username</MudTh>
                <MudTh>Roles</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Username">@context.Username</MudTd>
                <MudTd DataLabel="Roles">@RoleNames(context)</MudTd>
                <MudTd DataLabel="Status">@context.Status</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="py-10 text-center text-slate-500">No system users.</div>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>
