@page "/documents/{LoadedTabsId:int?}"
@using static zxadocsfe.Helpers.AppConstants
@using zxadocsui.Components.Folders
<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <!-- header: app title + simple action (compose) -->
    <div class="px-6 py-5 border-b border-slate-200 flex items-center justify-between bg-white/90 backdrop-blur-sm">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
                <i class="fas fa-envelope text-sm"></i>
            </div>
            <h1 class="text-xl font-semibold text-slate-800 tracking-tight">Document centre</h1>
        </div>
        <NavLink href="/createdocument" Match="NavLinkMatch.Prefix">
            <span class=" text-green-800">
                <i class="fa fa-pen" style="width: 20px;"></i>
            </span>
            Outbox
        </NavLink>
        @* <MudButton OnClick="@(()=>CreateDocument())" StartIcon="@Icons.Material.Filled.Edit" Color="Color.Primary">Compose
        </MudButton> *@
    </div>
    @* ActivePanelIndex is controlled so ?tab=inbox can select a panel on arrival; IndexChanged
       writes it back, otherwise clicking a tab would snap straight back to the bound value. *@
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6"
             ActivePanelIndex="activeTab" ActivePanelIndexChanged="IndexChanged">
        <MudTabPanel Text="Inbox" Icon="@Icons.Material.Filled.Inbox">
            <FolderMessages DocList="inboxList" FolderType="FolderType.Inbox" />
        </MudTabPanel>
        <MudTabPanel Text="Outbox" Icon="@Icons.Material.Filled.Outbox">
            <FolderMessages DocList="outboxList" FolderType="FolderType.Outbox" />
        </MudTabPanel>
        <MudTabPanel Text="Archieved" Icon="@Icons.Material.Filled.Archive">
            <FolderMessages DocList="archievedList" FolderType="FolderType.Archive" />
        </MudTabPanel>
        <MudTabPanel Text="Deleted" Icon="@Icons.Material.Filled.Delete">
            <FolderMessages DocList="deletedList" FolderType="FolderType.Delete" />
        </MudTabPanel>
    </MudTabs>


</div>

<!-- tiny script for tab switching (plain js, no dependencies) -->
<script>
    (function () {
        const tabs = document.querySelectorAll(".tab-button");
        const panels = {
            inbox: document.getElementById("panel-inbox"),
            outbox: document.getElementById("panel-outbox"),
            archived: document.getElementById("panel-archived"),
            deleted: document.getElementById("panel-deleted"),
        };

        // helper: remove active state from all tabs & panels, then activate
        function activateTab(tabId) {
            // update tab buttons
            tabs.forEach((btn) => {
                const isActive = btn.dataset.tab === tabId;
                // aria-selected
                btn.setAttribute("aria-selected", isActive ? "true" : "false");
                // style classes
                if (isActive) {
                    btn.classList.add(
                        "active-tab",
                        "text-indigo-700",
                        "border-indigo-500",
                        "bg-white",
                        "font-semibold"
                    );
                    btn.classList.remove("text-slate-600", "hover:text-slate-900", "border-transparent");
                } else {
                    btn.classList.remove(
                        "active-tab",
                        "text-indigo-700",
                        "border-indigo-500",
                        "bg-white",
                        "font-semibold"
                    );
                    btn.classList.add("text-slate-600", "hover:text-slate-900", "border-transparent");
                }
            });

            // hide all panels, show the selected one
            Object.values(panels).forEach((panel) => panel.classList.add("hidden"));
            if (panels[tabId]) panels[tabId].classList.remove("hidden");
        }

        // add click listener to each tab
        tabs.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const tabId = btn.dataset.tab;
                if (tabId) activateTab(tabId);
            });

            // optional keyboard support (Enter/Space activate)
            btn.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    const tabId = btn.dataset.tab;
                    if (tabId) activateTab(tabId);
                }
            });
        });

        // initial active state: inbox is open (default in html)
        // ensure classes correspond on page load (in case of mismatch)
        activateTab("inbox");
    })();
</script>