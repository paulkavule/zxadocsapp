<!-- tiny script for tab switching (plain js, no dependencies) -->
<script>
    (function () {
        const tabs = document.querySelectorAll(".tab-button");
        const panels = {
            inbox: document.getElementById("panel-inbox"),
            outbox: document.getElementById("panel-outbox"),
            archived: document.getElementById("panel-archived"),
            deleted: document.getElementById("panel-deleted"),
        };

        // helper: remove active state from all tabs & panels, then activate
        function activateTab(tabId) {
            // update tab buttons
            tabs.forEach((btn) => {
                const isActive = btn.dataset.tab === tabId;
                // aria-selected
                btn.setAttribute("aria-selected", isActive ? "true" : "false");
                // style classes
                if (isActive) {
                    btn.classList.add(
                        "active-tab",
                        "text-indigo-700",
                        "border-indigo-500",
                        "bg-white",
                        "font-semibold"
                    );
                    btn.classList.remove("text-slate-600", "hover:text-slate-900", "border-transparent");
                } else {
                    btn.classList.remove(
                        "active-tab",
                        "text-indigo-700",
                        "border-indigo-500",
                        "bg-white",
                        "font-semibold"
                    );
                    btn.classList.add("text-slate-600", "hover:text-slate-900", "border-transparent");
                }
            });

            // hide all panels, show the selected one
            Object.values(panels).forEach((panel) => panel.classList.add("hidden"));
            if (panels[tabId]) panels[tabId].classList.remove("hidden");
        }

        // add click listener to each tab
        tabs.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const tabId = btn.dataset.tab;
                if (tabId) activateTab(tabId);
            });

            // optional keyboard support (Enter/Space activate)
            btn.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    const tabId = btn.dataset.tab;
                    if (tabId) activateTab(tabId);
                }
            });
        });

        // initial active state: inbox is open (default in html)
        // ensure classes correspond on page load (in case of mismatch)
        activateTab("inbox");
    })();
</script>
