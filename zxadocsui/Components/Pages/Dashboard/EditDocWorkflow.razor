@using zxadocsfe.Dtos
@using zxadocsfe.Services
@using zxadocslib.Dtos
@using zxadocsui.Srevices
@using zxadocsui.State

<MudSelect T="int" @bind-Value="Work.RoleId" Label="User Role" Placeholder="Select role" Variant="Variant.Outlined">
    @foreach (var item in userRoles)
    {
        <MudSelectItem T="int" Value="@item.RoleId">@item.RoleName</MudSelectItem>
    }
</MudSelect>
<MudSwitch @bind-Value="isRequired" Color="Color.Primary" />

<MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" FullWidth="true"
           OnClick="@(()=>OkayClicked())" class="mt-3"> Save
</MudButton>
@code {

    [Inject] ISnackbar Snackbar { set; get; } = default!;
    [Inject] ILogger<CreateDocumentWorkflow> logger { set; get; } = default!;
    [Inject] SideDialogService sideDialog { set; get; } = default!;
    [Inject] IHttpService httpSvc { get; set; } = default!;
    [Inject] IUserSession session { set; get; } = default!;
    [Parameter] public WorkFlow Work { set; get; } = new();
    private List<UserRole> userRoles = new();
    UserData? userData = default!;
    bool isRequired = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (!firstRender)
                return;
            userData = await session.GetCurrentUser();

            isRequired = Work.IsRequired;
            await loadUserRoles();
        }
        catch (Exception ee)
        {
            logger!.LogError(ee, ee.Message);
        }

    }

    private async Task loadUserRoles()
    {
        try
        {

            // The org now comes from the token, not the URL (ZD-94).
            var (status, result, message) = await
httpSvc!.GetAsync<ApiResponse<List<UserRole>>>("api/userroles");
            if (status == false || result?.Data == null) return;

            userRoles = result.Data;

            userRoles.Insert(0, new UserRole { RoleId = 0, RoleName = "Select" });
        }
        catch (Exception ex)
        {
            logger!.LogDebug(ex.Message);
        }
    }

    void OkayClicked()
    {
        var role = userRoles.FirstOrDefault(ur => ur.RoleId == Work.RoleId);
        Work.IsRequired = isRequired;
        Work.RoleName = role?.RoleName ?? "";
        sideDialog.Close(Work);
    }


}