@page "/templates/new"
@layout DashboardLayout
@using zxadocslib.Dtos
@using zxadocslib.Helpers
@using zxadocsui.Components.Custom

<div class="w-full bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-200 flex items-center gap-3 bg-white/90 backdrop-blur-sm">
        <div class="w-8 h-8 bg-green-600 rounded-xl flex items-center justify-center text-white shadow-sm">
            <i class="fas fa-file-circle-plus text-sm"></i>
        </div>
        <h1 class="text-xl font-semibold text-slate-800 tracking-tight">New template</h1>
    </div>

    <div class="p-6 space-y-8 max-w-4xl">
        <!-- 1. Details -->
        <section>
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <MudTextField @bind-Value="name" Label="Template name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <div>
                    <MudSelect T="int" @bind-Value="categoryId" Label="Category" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var c in categories)
                        {
                            <MudSelectItem Value="c.Id">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                    @if (categories.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Class="text-slate-500">
                            No categories yet — add “Template category” values in <MudLink Href="/settings">Organisation settings</MudLink> first.
                        </MudText>
                    }
                </div>
                <div class="md:col-span-2">
                    <MudTextField @bind-Value="description" Label="Description" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
            </div>
        </section>

        <!-- 2. Merge fields (defined first so they can be inserted into the body) -->
        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide">Merge fields</h2>
                <MudButton OnClick="AddField" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                    Add field
                </MudButton>
            </div>

            <table class="w-full text-sm border border-slate-200 rounded-xl overflow-hidden">
                <thead class="bg-slate-50 text-slate-500">
                    <tr class="text-left">
                        <th class="px-3 py-2 font-medium w-[18%]">Key</th>
                        <th class="px-3 py-2 font-medium w-[22%]">Label</th>
                        <th class="px-3 py-2 font-medium w-[16%]">Type</th>
                        <th class="px-3 py-2 font-medium w-[28%]">Options (Dropdown)</th>
                        <th class="px-3 py-2 font-medium w-[8%] text-center">Required</th>
                        <th class="px-3 py-2 font-medium w-[8%]"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (fields.Count == 0)
                    {
                        <tr><td colspan="6" class="px-3 py-6 text-center text-slate-400">
                            No merge fields. Add one per <code>{{key}}</code> token used in the contract.
                        </td></tr>
                    }
                    @foreach (var f in fields)
                    {
                        <tr class="border-t border-slate-100 align-top">
                            <td class="px-2 py-1">
                                <MudTextField @bind-Value="f.Key" Placeholder="party_name" Variant="Variant.Text" Margin="Margin.Dense" />
                            </td>
                            <td class="px-2 py-1">
                                <MudTextField @bind-Value="f.Label" Placeholder="Party name" Variant="Variant.Text" Margin="Margin.Dense" />
                            </td>
                            <td class="px-2 py-1">
                                <MudSelect T="TemplateFieldType" @bind-Value="f.Type" Variant="Variant.Text" Margin="Margin.Dense">
                                    @foreach (var t in Enum.GetValues<TemplateFieldType>())
                                    {
                                        <MudSelectItem Value="t">@t</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td class="px-2 py-1">
                                <MudTextField @bind-Value="f.OptionsCsv" Placeholder="Option A, Option B" Disabled="@(f.Type != TemplateFieldType.Dropdown)"
                                              Variant="Variant.Text" Margin="Margin.Dense" />
                            </td>
                            <td class="px-2 py-1 text-center">
                                <MudCheckBox @bind-Value="f.Required" />
                            </td>
                            <td class="px-2 py-1 text-right">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveField(f))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- 3. Contract body (rich text) -->
        <section>
            <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-3">
                Contract body
                <span class="normal-case font-normal text-slate-400">— write the contract and use “Insert field” to drop <code>{{key}}</code> tokens</span>
            </h2>
            <RichTextEditor @ref="editorRef" Tokens="@fields.Select(f => f.Key).Where(k => !string.IsNullOrWhiteSpace(k))" />
        </section>

        @if (busy && uploadProgress > 0)
        {
            <MudProgressLinear Color="Color.Primary" Value="uploadProgress" Class="my-2" />
        }

        <!-- actions -->
        <div class="flex items-center gap-3 pt-2 border-t border-slate-200">
            <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy"
                       StartIcon="@Icons.Material.Filled.Save">
                @(busy ? "Saving…" : "Save template")
            </MudButton>
            <MudButton Href="/templates" Variant="Variant.Text" Disabled="busy">Cancel</MudButton>
        </div>
    </div>
</div>
