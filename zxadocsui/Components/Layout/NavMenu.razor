<div class="flex flex-col justify-center items-center text-white">
    <img src="images/zxadocs_logo.png" alt="ZXADOCS Logo"/>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3 py-3">
            <NavLink href="new-document" class="d-block">
                <button class="w-full gap-3 py-3 px-3 rounded-lg"
                        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; font-size: 0.95rem;">
                    <i class="fa fa-plus-circle"></i>
                    <span>New Document</span>
                </button>
            </NavLink>
        </div>

        <div class="nav-divider my-2"></div>

        <MudNavMenu Style="padding: 0; background: transparent;">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Style="margin-bottom: 0.25rem;"
                        Icon="@Icons.Material.Filled.Message">
                Messages
            </MudNavLink>
            <MudNavGroup Title="Settings" Expanded="true" Class="text-green-800" Icon="@Icons.Material.Filled.Settings"
                         Style="margin-bottom: 0.5rem;">
                <MudNavLink Href="/users" Match="NavLinkMatch.Prefix">
                    <i class="fa fa-users me-2" style="width: 20px;"></i>
                    Users
                </MudNavLink>
                <MudNavLink Href="/security" Match="NavLinkMatch.Prefix">
                    <i class="fa fa-cubes me-2" style="width: 20px;"></i>
                    Document Categories
                </MudNavLink>
                <MudNavLink Href="/security" Match="NavLinkMatch.Prefix">
                    <i class="fa fa-sliders me-2" style="width: 20px;"></i>
                    Document Types
                </MudNavLink>
                <MudNavLink Href="/security" Match="NavLinkMatch.Prefix">
                    <i class="fa fa-dot-circle-o me-2" style="width: 20px;"></i>
                    Options
                </MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Reports" Expanded="true" Class="text-green-800" Icon="@Icons.Material.Filled.Bookmark"
                         Style="margin-bottom: 0.5rem;">
                <MudNavLink Href="/users" Match="NavLinkMatch.Prefix">
                    <span class=" text-green-800">
                        <i class="fa fa-inbox" style="width: 20px;"></i>
                    </span>
                    Outbox
                </MudNavLink>
                <MudNavLink Href="/security" Match="NavLinkMatch.Prefix">
                    <i class="fa fa-bank me-2" style="width: 20px;"></i>
                    Audit
                </MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </nav>
</div>

<style>
    .nav-divider {
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(102, 126, 234, 0.4) !important;
    }

    .transition-all {
        transition: all 0.3s ease;
    }

    :deep(.mud-nav-link) {
        border-radius: 8px;
        margin: 0.25rem 0.5rem;
        padding: 0.75rem 1rem !important;
        color: #333;
        transition: all 0.2s ease;
    }

    :deep(.mud-nav-link:hover) {
        background-color: rgba(102, 126, 234, 0.1);
        color: #667eea;
    }

    :deep(.mud-nav-link-active) {
        background-color: rgba(102, 126, 234, 0.2);
        color: #667eea;
        font-weight: 600;
        border-left: 4px solid #667eea;
        padding-left: calc(1rem - 4px) !important;
    }

    :deep(.mud-nav-group-header) {
        border-radius: 8px;
        margin: 0.5rem;
        padding: 0.75rem 1rem !important;
        color: #555;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
</style>