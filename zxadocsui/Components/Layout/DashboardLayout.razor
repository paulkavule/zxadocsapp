@using zxadocsui.Components.Shared
@using zxadocsui.Helpers
@inherits LayoutComponentBase

<MudThemeProvider Theme="@ThemeProvider.GeneralTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
@* <MudPopoverProvider /> *@



<div class="bg-[#f4faf3] font-sans text-[#1e3a2f] antialiased">
    <div class="flex min-h-screen">
        <!-- SIDEBAR -->
        <aside id="sidebar"
               class="sidebar-transition bg-white border-r border-[#cfe3d5] shadow-sm flex flex-col fixed inset-y-0 left-0 w-72 overflow-y-auto no-scrollbar z-30">

            <!-- logo + toggle row -->
            <div class="h-20 flex items-center justify-between px-6 border-b border-[#d8ecd9] shrink-0">
                <div class="flex items-center space-x-2 overflow-hidden">
                    <div class="bg-[#1f7b4d] text-white p-2 rounded-xl shadow-md shrink-0">
                        <img src="/images/zxadocs_icon_124_white.png" width="30" />
                    </div>
                    <span
                    class="font-bold text-xl text-[#195d3a] tracking-tight whitespace-nowrap sidebar-logo-text">zxadocs</span>
                </div>
                <button id="toggleSidebar"
                        class="text-[#5f8b74] hover:text-[#1f7b4d] transition p-1.5 rounded-lg hover:bg-[#e0f2df]">
                    <i class="fa-solid fa-chevron-left" id="toggleIcon"></i>
                </button>
            </div>

            <!-- SIDEBAR NAVIGATION -->
            <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
                <div class="text-xs font-semibold text-[#5b8c70] uppercase tracking-wider px-4 mb-2 sidebar-menu-label">
                    Overview</div>
                    <!-- Use NavLink for proper Blazor navigation -->
                    <NavLink href="/dashboard"
                             class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition group menu-item"
                             ActiveClass="bg-[#e0f2df]" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-gauge-high w-5 text-[#2a7f4f] group-hover:text-[#1d673e] flex-shrink-0"></i>
                        <span class="font-medium whitespace-nowrap sidebar-menu-text">Dashboard</span>
                        <span
                        class="ml-auto bg-[#daf1da] text-[#1f7b4d] text-xs font-semibold px-2 py-0.5 rounded-full sidebar-badge">24</span>
                    </NavLink>

                    <NavLink href="/documents"
                             class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition group menu-item"
                             ActiveClass="bg-[#e0f2df]">
                        <i
                        class="fa-regular fa-folder-open w-5 text-[#2a7f4f] group-hover:text-[#1d673e] flex-shrink-0"></i>
                        <span class="font-medium whitespace-nowrap sidebar-menu-text">Documents</span>
                        <span
                        class="ml-auto bg-[#daf1da] text-[#1f7b4d] text-xs font-semibold px-2 py-0.5 rounded-full sidebar-badge">243</span>
                    </NavLink>

                    <NavLink href="/workflows"
                             class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition group menu-item"
                             ActiveClass="bg-[#e0f2df]">
                        <i
                        class="fa-regular fa-rectangle-list w-5 text-[#2a7f4f] group-hover:text-[#1d673e] flex-shrink-0"></i>
                        <span class="font-medium whitespace-nowrap sidebar-menu-text">Workflows</span>
                    </NavLink>

                    <!-- DIVIDER -->
                    <div class="border-t border-[#d4ead5] my-4"></div>

                    <!-- section label -->
                    <div class="text-xs font-semibold text-[#5b8c70] uppercase tracking-wider px-4 mb-2 sidebar-menu-label">
                        Analytics</div>

                        <!-- REPORTS SECTION (collapsible submenu) -->
                        <div id="reportsToggle"
                             class="flex items-center justify-between px-4 py-3 rounded-xl cursor-pointer hover:bg-[#e0f2df] transition group menu-item">
                            <div class="flex items-center space-x-3">
                                <i
                                class="fa-solid fa-chart-pie w-5 text-[#2a7f4f] group-hover:text-[#1d673e] flex-shrink-0"></i>
                                <span class="font-medium whitespace-nowrap sidebar-menu-text">Reports</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-[#5f8b74] transition-transform duration-200"
                               id="reportsChevron"></i>
                        </div>

                        <!-- SUBMENU -->
                        <div id="reportsSubmenu" class="submenu max-h-0 opacity-0">
                            <div class="pl-12 pr-4 space-y-1 mt-1">
                                <NavLink href="/reports/activity"
                                         class="flex items-center py-2.5 px-3 text-sm text-[#1e4a33] hover:bg-[#e0f2df] rounded-xl transition"
                                         ActiveClass="bg-[#e0f2df]">
                                    <i class="fa-regular fa-chart-bar w-4 text-[#5f8b74] mr-2"></i>
                                    <span class="sidebar-submenu-text">Document activity</span>
                                </NavLink>
                                <NavLink href="/reports/approval-times"
                                         class="flex items-center py-2.5 px-3 text-sm text-[#1e4a33] hover:bg-[#e0f2df] rounded-xl transition"
                                         ActiveClass="bg-[#e0f2df]">
                                    <i class="fa-regular fa-clock w-4 text-[#5f8b74] mr-2"></i>
                                    <span class="sidebar-submenu-text">Approval times</span>
                                </NavLink>
                                <NavLink href="/reports/submissions"
                                         class="flex items-center py-2.5 px-3 text-sm text-[#1e4a33] hover:bg-[#e0f2df] rounded-xl transition"
                                         ActiveClass="bg-[#e0f2df]">
                                    <i class="fa-regular fa-user w-4 text-[#5f8b74] mr-2"></i>
                                    <span class="sidebar-submenu-text">User submissions</span>
                                </NavLink>
                            </div>
                        </div>

                        <NavLink href="/audit"
                                 class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition group menu-item mt-2"
                                 ActiveClass="bg-[#e0f2df]">
                            <i class="fa-regular fa-clock w-5 text-[#2a7f4f] group-hover:text-[#1d673e] flex-shrink-0"></i>
                            <span class="font-medium whitespace-nowrap sidebar-menu-text">Audit trail</span>
                        </NavLink>

                        <div class="border-t border-[#d4ead5] my-4"></div>

                        <div class="text-xs font-semibold text-[#5b8c70] uppercase tracking-wider px-4 mb-2 sidebar-menu-label">
                            Administration</div>

                            <NavLink href="/settings"
                                     class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition menu-item"
                                     ActiveClass="bg-[#e0f2df]">
                                <i class="fa-solid fa-gear w-5 text-[#5b8c70] flex-shrink-0"></i>
                                <span class="font-medium whitespace-nowrap sidebar-menu-text">Settings</span>
                            </NavLink>
                            <NavLink href="/team"
                                     class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition menu-item"
                                     ActiveClass="bg-[#e0f2df]">
                                <i class="fa-solid fa-users w-5 text-[#5b8c70] flex-shrink-0"></i>
                                <span class="font-medium whitespace-nowrap sidebar-menu-text">Team</span>
                            </NavLink>
                            <NavLink href="/notifications"
                                     class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition menu-item"
                                     ActiveClass="bg-[#e0f2df]">
                                <i class="fa-regular fa-bell w-5 text-[#5b8c70] flex-shrink-0"></i>
                                <span class="font-medium whitespace-nowrap sidebar-menu-text">Notifications</span>
                                <span
                                class="ml-auto bg-[#f1e5c0] text-[#7d6b40] text-xs px-2 py-0.5 rounded-full sidebar-badge">3</span>
                            </NavLink>
                        </nav>

                        <!-- USER PROFILE BOTTOM -->
                        <div class="border-t border-[#d4ead5] p-5 shrink-0">
                            <div class="flex items-center space-x-3">
                                <span
                                class="w-10 h-10 rounded-full bg-[#cbeace] flex items-center justify-center text-[#1f7b4d] font-semibold text-lg shrink-0">JD</span>
                                <div class="flex-1 min-w-0 sidebar-user-info">
                                    <p class="text-sm font-semibold text-[#195d3a] truncate">Jessie Du</p>
                                    <p class="text-xs text-[#5f8b74] truncate">j.du@zxadocs</p>
                                </div>
                                <i
                                class="fa-solid fa-ellipsis-vertical text-[#8bb89b] hover:text-[#1f7b4d] cursor-pointer shrink-0"></i>
                            </div>
                        </div>
                    </aside>

                    <!-- MAIN CONTENT AREA -->
                    <main id="mainContent" class="content-transition flex-1 ml-72 bg-[#f4faf3] min-h-screen"
                          style="margin-left: 18rem;">

                        <!-- TOP HEADER -->
                        <header
                            class="bg-white border-b border-[#cfe3d5] h-20 flex items-center justify-between px-8 sticky top-0 z-10">
                            <div class="flex items-center flex-1 max-w-lg">
                                <div class="relative w-full">
                                    <i
                                    class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[#8bb89b] text-sm"></i>
                                    <input type="text" placeholder="Search..."
                                           class="w-full pl-11 pr-4 py-2.5 border border-[#cfe3d5] rounded-xl bg-[#f6fcf7] focus:bg-white focus:border-[#44a56d] focus:ring-2 focus:ring-[#daf1dc] transition text-sm">
                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <button class="p-2.5 hover:bg-[#e0f2df] rounded-xl text-[#2a7f4f] transition relative">
                                    <i class="fa-regular fa-bell text-lg"></i>
                                    <span
                                    class="absolute top-1.5 right-1.5 w-2 h-2 bg-[#e6b85e] rounded-full ring-2 ring-white"></span>
                                </button>
                                <button class="p-2.5 hover:bg-[#e0f2df] rounded-xl text-[#2a7f4f] transition">
                                    <i class="fa-regular fa-envelope text-lg"></i>
                                </button>
                                <div class="h-8 w-px bg-[#cfe3d5]"></div>
                                <NavLink href="/newdocument"
                                         class="flex items-center space-x-3 text-[#1e4a33] hover:bg-[#e0f2df] px-4 py-3 rounded-xl transition group menu-item"
                                         ActiveClass="bg-[#e0f2df]">
                                    <i
                                    class="fa-regular fa-rectangle-list w-5 text-[#2a7f4f] group-hover:text-[#1d673e] shrink-0"></i>
                                    <span class="font-medium whitespace-nowrap sidebar-menu-text">New</span>
                                </NavLink>
                                @* <button
                                    class="bg-[#1f7b4d] hover:bg-[#16633d] text-white px-5 py-2 rounded-xl text-sm font-semibold shadow-sm transition flex items-center gap-2">
                                    <i class="fa-solid fa-plus"></i> New
                                </button> *@
                            </div>
                        </header>

                        <!-- PAGE CONTENT -->
                        <div class="p-8">
                            @Body
                        </div>
                    </main>
                </div>
                <SideDialog />
            </div>