@inherits LayoutComponentBase

<MudDialogProvider />
<MudSnackbarProvider />
@* <MudPopoverProvider /> *@

    <div class="flex min-h-screen">
        <!-- SIDEBAR -->
        <aside id="sidebar" class="sidebar-transition bg-white flex flex-col fixed inset-y-0 left-0 w-72 overflow-y-auto no-scrollbar z-30">

            <!-- Logo Row -->
            <div class="h-20 flex items-center justify-between px-6 border-b border-gray-50 shrink-0 logo-container">
                <div class="flex items-center space-x-3 overflow-hidden">
                    <div class="bg-[#1f7b4d] text-white p-2 rounded-xl shadow-md shrink-0">
                        <i class="fa-solid fa-file-lines text-xl"></i>
                    </div>
                    <span class="font-bold text-xl text-[#1e3a2f] tracking-tight whitespace-nowrap sidebar-logo-text">zxadocs</span>
                </div>
            </div>

            <!-- SIDEBAR NAVIGATION -->
            <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
                <div class="text-[10px] font-bold text-[#1e3a2f] opacity-40 uppercase tracking-widest px-4 mb-3 sidebar-menu-label">
                    Overview
                </div>
                
                <a href="#" class="flex items-center space-x-3 text-[#1e3a2f] bg-[#f4faf3] px-4 py-3 rounded-xl transition group menu-item shadow-sm border border-[#1e3a2f]/5">
                    <i class="fa-solid fa-gauge-high w-5 text-[#1f7b4d] flex-shrink-0"></i>
                    <span class="font-semibold whitespace-nowrap sidebar-menu-text">Dashboard</span>
                    <span class="ml-auto bg-emerald-100 text-[#1f7b4d] text-[10px] font-black px-2 py-0.5 rounded-full sidebar-badge">24</span>
                </a>

                <a href="#" class="flex items-center space-x-3 text-[#1e3a2f] hover:bg-[#f4faf3] px-4 py-3 rounded-xl transition group menu-item opacity-80 hover:opacity-100">
                    <i class="fa-regular fa-folder-open w-5 text-[#1f7b4d] flex-shrink-0"></i>
                    <span class="font-medium whitespace-nowrap sidebar-menu-text">Documents</span>
                    <span class="ml-auto bg-gray-100 text-gray-500 text-[10px] font-bold px-2 py-0.5 rounded-full sidebar-badge">243</span>
                </a>

                <a href="#" class="flex items-center space-x-3 text-[#1e3a2f] hover:bg-[#f4faf3] px-4 py-3 rounded-xl transition group menu-item opacity-80 hover:opacity-100">
                    <i class="fa-regular fa-rectangle-list w-5 text-[#1f7b4d] flex-shrink-0"></i>
                    <span class="font-medium whitespace-nowrap sidebar-menu-text">Workflows e</span>
                </a>

                <div class="h-px bg-gray-100 my-6 mx-4"></div>

                <div class="text-[10px] font-bold text-[#1e3a2f] opacity-40 uppercase tracking-widest px-4 mb-3 sidebar-menu-label">
                    Analytics
                </div>

                <!-- COLLAPSIBLE SECTION -->
                <div onclick="toggleSubmenu()" class="flex items-center justify-between px-4 py-3 rounded-xl cursor-pointer hover:bg-[#f4faf3] transition group menu-item opacity-80 hover:opacity-100">
                    <div class="flex items-center space-x-3">
                        <i class="fa-solid fa-chart-pie w-5 text-[#1f7b4d] flex-shrink-0"></i>
                        <span class="font-medium whitespace-nowrap sidebar-menu-text">Reports</span>
                    </div>
                    <i id="reportsChevron" class="fa-solid fa-chevron-down text-[10px] opacity-40 transition-transform duration-200"></i>
                </div>

                <div id="reportsSubmenu" class="submenu">
                    <div class="pl-12 pr-4 space-y-1 mt-1">
                        <a href="#" class="block py-2 text-sm text-[#1e3a2f] opacity-60 hover:opacity-100 transition">Activity</a>
                        <a href="#" class="block py-2 text-sm text-[#1e3a2f] opacity-60 hover:opacity-100 transition">Approval Times</a>
                    </div>
                </div>

                <a href="#" class="flex items-center space-x-3 text-[#1e3a2f] hover:bg-[#f4faf3] px-4 py-3 rounded-xl transition group menu-item opacity-80 hover:opacity-100">
                    <i class="fa-regular fa-clock w-5 text-[#1f7b4d] flex-shrink-0"></i>
                    <span class="font-medium whitespace-nowrap sidebar-menu-text">Audit Trail</span>
                </a>

                <div class="h-px bg-gray-100 my-6 mx-4"></div>

                <div class="text-[10px] font-bold text-[#1e3a2f] opacity-40 uppercase tracking-widest px-4 mb-3 sidebar-menu-label">
                    System
                </div>

                <a href="#" class="flex items-center space-x-3 text-[#1e3a2f] hover:bg-[#f4faf3] px-4 py-3 rounded-xl transition menu-item opacity-80 hover:opacity-100">
                    <i class="fa-solid fa-gear w-5 text-[#1f7b4d] flex-shrink-0"></i>
                    <span class="font-medium whitespace-nowrap sidebar-menu-text">Settings</span>
                </a>
            </nav>

            <!-- USER PROFILE BOTTOM -->
            <div class="border-t border-gray-50 p-5 shrink-0 bg-white sticky bottom-0">
                <div class="flex items-center space-x-3">
                    <img class="w-10 h-10 rounded-xl object-cover shrink-0 border border-gray-100" src="https://ui-avatars.com/api/?name=Jessie+Du&background=1f7b4d&color=fff&bold=true" alt="User">
                    <div class="flex-1 min-w-0 sidebar-user-info">
                        <p class="text-sm font-bold text-[#1e3a2f] truncate">Jessie Du</p>
                        <p class="text-[10px] text-[#1e3a2f] opacity-50 truncate font-semibold uppercase tracking-tight">Admin</p>
                    </div>
                    <button class="text-[#1e3a2f] opacity-20 hover:opacity-100 transition shrink-0">
                        <i class="fa-solid fa-ellipsis-vertical"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main id="mainContent" class="flex-1 ml-72 transition-all duration-300">

            <!-- TOP HEADER -->
            <header class="bg-white h-20 flex items-center justify-between px-8 sticky top-0 z-10">
                <div class="flex items-center space-x-6 flex-1">
                    <button onclick="toggleSidebar()" class="text-[#1e3a2f] hover:bg-[#f4faf3] p-2.5 rounded-xl transition">
                        <i class="fa-solid fa-bars-staggered text-xl"></i>
                    </button>
                    
                    <div class="relative w-full max-w-md hidden md:block">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-[#1e3a2f] opacity-30 text-sm"></i>
                        <input type="text" placeholder="Search resources..."
                               class="w-full pl-11 pr-4 py-2.5 border border-gray-100 rounded-2xl bg-[#f4faf3]/50 focus:bg-white focus:border-[#1f7b4d] focus:ring-4 focus:ring-[#1f7b4d]/5 transition text-sm">
                    </div>
                </div>

                <div class="flex items-center space-x-3">
                    <button class="p-2.5 hover:bg-[#f4faf3] rounded-xl text-[#1e3a2f] opacity-60 hover:opacity-100 transition relative">
                        <i class="fa-regular fa-bell text-lg"></i>
                        <span class="absolute top-2.5 right-2.5 w-2 h-2 bg-rose-500 rounded-full ring-2 ring-white"></span>
                    </button>
                    <div class="h-8 w-px bg-gray-100 mx-2"></div>
                    <button class="bg-[#1f7b4d] hover:bg-[#16633d] text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-[#1f7b4d]/20 transition flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i> New File
                    </button>
                </div>
            </header>

            <!-- PAGE CONTENT -->
            <div class="p-10">
                <div class="mb-10">
                    <h1 class="text-3xl font-black text-[#1e3a2f] tracking-tight">Main Console</h1>
                    <p class="text-[#1e3a2f] opacity-50 mt-1 font-medium">Monitoring document flows and user activity.</p>
                </div>

                <!-- Simple Placeholder for @Body -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm">
                        <div class="w-12 h-12 bg-[#f4faf3] text-[#1f7b4d] rounded-2xl flex items-center justify-center mb-6">
                            <i class="fa-solid fa-file-invoice text-xl"></i>
                        </div>
                        <h3 class="text-lg font-bold text-[#1e3a2f]">Recent Submissions</h3>
                        <p class="text-sm text-[#1e3a2f] opacity-40 mt-2">12 new documents pending review from your team.</p>
                    </div>
                    <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm">
                        <div class="w-12 h-12 bg-[#f4faf3] text-[#1f7b4d] rounded-2xl flex items-center justify-center mb-6">
                            <i class="fa-solid fa-clock-rotate-left text-xl"></i>
                        </div>
                        <h3 class="text-lg font-bold text-[#1e3a2f]">Average Approval</h3>
                        <p class="text-sm text-[#1e3a2f] opacity-40 mt-2">Current turnaround is 4.2 hours per workflow.</p>
                    </div>
                    <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-sm border-dashed border-2 flex flex-col items-center justify-center text-center opacity-60">
                         <div class="w-10 h-10 border-2 border-[#1e3a2f]/20 rounded-full flex items-center justify-center mb-2">
                             <i class="fa-solid fa-plus text-[#1e3a2f]/40"></i>
                         </div>
                         <span class="text-xs font-bold uppercase tracking-widest text-[#1e3a2f]">Add Widget</span>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const mainContent = document.getElementById('mainContent');
            sidebar.classList.toggle('mini');
            
            if (sidebar.classList.contains('mini')) {
                mainContent.style.marginLeft = '5rem';
                document.getElementById('reportsSubmenu').classList.remove('open');
            } else {
                mainContent.style.marginLeft = '18rem';
            }
        }

        function toggleSubmenu() {
            const sidebar = document.getElementById('sidebar');
            if (sidebar.classList.contains('mini')) {
                toggleSidebar();
            }
            const submenu = document.getElementById('reportsSubmenu');
            const chevron = document.getElementById('reportsChevron');
            submenu.classList.toggle('open');
            chevron.classList.toggle('rotate-180');
        }

        // Adjust layout on load/resize
        window.addEventListener('resize', () => {
            const mainContent = document.getElementById('mainContent');
            if (window.innerWidth < 1024) {
                // Simplified mobile logic could be added here
            }
        });
    </script>