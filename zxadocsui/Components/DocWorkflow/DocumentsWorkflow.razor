@using zxadocsfe.Dtos
@using zxadocslib.Dtos

<div class="w-1/3">
    <p>Add actors in the order of authorization</p>
    <div class="flex justify-between items-center my-3">
        <MudAutocomplete T="DocsWorkflow" Variant="Variant.Outlined" Label="Actor" Placeholder="Actor"
                         ValueChanged="OnForwardToChanged" Dense="true" Clearable="true" CoerceText="true"
                         ResetValueOnEmptyText="true" SearchFunc="SearchCountries" ToStringFunc="@(s => s?.Name ?? string.Empty)">
        </MudAutocomplete>
        @* <div class="w-3/4 gap-3">
            

        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Class="" OnClick="AddActor" /> *@
    </div>

    <div class="bg-white rounded-lg shadow divide-y divide-gray-200">
        @for (int i = 0; i < workflowList.Count; i++)
        {
            var item = workflowList[i];

            <div class="flex items-center justify-between px-4 py-3 hover:bg-gray-50">
                <div class="flex justify-center items-center gap-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => DeleteItem(item))" />
                    <span class="bg-black text-white w-5 h-5 rounded-full text-center">@item.Level</span>

                </div>


                <div class="text-sm font-medium text-gray-800 ">
                    <span>@item.Name</span>
                </div>

                <div class="flex flex-col gap-1">

                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowUpward"
                               Disabled="@(i == 0)" OnClick="() => MoveUp(item)" Class="p-0" />

                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowDownward"
                               Disabled="@(i == workflowList.Count - 1)" OnClick="() => MoveDown(item)" Class="p-0" />

                </div>

            </div>
        }
    </div>

</div>