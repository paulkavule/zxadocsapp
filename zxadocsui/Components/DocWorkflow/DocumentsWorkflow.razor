@using zxadocsfe.Dtos
@using zxadocslib.Dtos

<div class="w-1/3">
@if(defaultWorkflow?.Count > 0 && workflowList.Count >0){
    <div class="my-3">
    <p class="text-center">A default workflow is already defined by you administrator for the selected document category</p>
    <p class="text-center">Choose which actors you would like to particepate in the document signin</p>
    </div>

}else{
    <p>Add actors in the order of authorization</p>
    <div class="flex justify-between items-center my-3">
        <MudAutocomplete T="DocsWorkflow" Variant="Variant.Outlined" Label="Actor" Placeholder="Actor"
                         ValueChanged="ActorSelected" Dense="true" Clearable="true" CoerceText="true" ResetValueOnEmptyText="true"
                         SearchFunc="SearchUsers" ToStringFunc="@(s => s?.Name ?? string.Empty)">
        </MudAutocomplete>
    </div>
    }
    @if (defaultWorkflow?.Count > 0)
    {
        <div class="flex justify-between items-center my-3">
            @for (int i = 0; i < defaultWorkflow.Count; i++)
            {
                var data = defaultWorkflow[i];

                var bgClass = i == 0
                    ? "bg-green-500 text-green-900"
                    : i == defaultWorkflow.Count - 1
                        ? "bg-blue-700 text-white"
                        : "bg-gray-700 text-white";

                <span class="@($"{bgClass} text-[10px] p-1 rounded-md")">
                    @data.RoleName
                </span>
                <i class="fa fa-arrow-right mx-1"></i> 
            }
            <span class="bg-red-700 text-white text-[10px] p-1 rounded-md "> @defaultWorkflow[0].RoleName </span>
        </div>

    }
    else
    {
        <p class="text-center">
            No predefined workflow
        </p>
    }

    @if (usersList.Count > 0)
    {
        <div class="flex justify-end my-2">
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshWorkflow">Refresh</MudButton>
        </div>
    }

    <div class="bg-white rounded-lg shadow divide-y divide-gray-200">
        @for (int i = 0; i < workflowList.Count; i++)
        {
            var item = workflowList[i];

            <div class="flex items-center justify-between px-4 py-3 hover:bg-gray-50">
                <div class="flex justify-center items-center gap-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => DeleteItem(item))" />
                    <span class="bg-black text-white w-5 h-5 rounded-full text-center">@item.Level</span>

                </div>


                <div class="text-sm font-medium text-gray-800 ">
                    <span>@item.Name</span>
                </div>

                <div class="flex flex-col gap-1">

                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowUpward"
                               Disabled="@(i == 0)" OnClick="() => MoveUp(item)" Class="p-0" />

                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowDownward"
                               Disabled="@(i == workflowList.Count - 1)" OnClick="() => MoveDown(item)" Class="p-0" />

                </div>

            </div>
        }
    </div>

</div>