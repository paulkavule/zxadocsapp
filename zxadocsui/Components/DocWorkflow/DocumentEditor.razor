@rendermode InteractiveServer
@using zxadocsfe.Helpers;

<div class="w-full flex justify-center items-center p-3">
    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false"
                    class="flex flex-wrap items-center gap-2 bg-white shadow-md rounded-xl p-2">

        <MudIconButton Icon="@Icons.Material.Filled.ModeEdit" Size="Size.Small" OnClick="AddSign"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Comment" Size="Size.Small" OnClick="AddComment"></MudIconButton>

        <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" OnClick="ZoomOut" />
        <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" OnClick="ZoomIn" />

        <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious" Size="Size.Small" OnClick="Prev"
                       class="max-w-[50px]" />

        <div class="flex items-center">
            <input type="number" min="1" max="@PageCount" value="@CurrentPage" @onchange="GoTo"
                   class="w-16 h-8 border border-gray-300 rounded-md text-center focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>

        <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" OnClick="Next" />

        <div class="flex items-center text-sm text-gray-600 px-2">
            Page @CurrentPage of @PageCount | Zoom @Scale
        </div>

        @* <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" OnClick="SaveDocument" /> *@
        <div class="relative inline-flex items-center justify-center">

            <!-- Progress overlay -->
            <div class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none">
                <MudProgressCircular Color="Color.Secondary" Value="@uploadProgress" Class="w-10 h-10" />
            </div>

            <!-- Upload button -->
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadFileDocument" Class="shadow-none">
                <CustomContent>
                    <MudFab DropShadow="false" Size="Size.Small" OnClick="@context.OpenFilePickerAsync"
                            StartIcon="@Icons.Material.Filled.AttachFile" Class="bg-white" />
                </CustomContent>
                <SelectedTemplate />
            </MudFileUpload>

        </div>


    </MudButtonGroup>
</div>

<div class="flex justify-center items-center">

    <div id="@_containerId"
         style="width:@(maxCanvasWidth)px; max-width:100%; border:1px solid #ddd; height:@(maxCanvasHeight)px; position:relative; overflow:auto;">

        @foreach (var attachment in attachments)
        {
            <div class="signBox resizable gentals" id="@attachment.ElementId" style="
                position:absolute;
                opacity:@(CurrentPage == attachment.Page ? "1" : "0");
                pointer-events:@(CurrentPage == attachment.Page ? "auto" : "none");
                transform: translate(@(attachment.PositionX)px, @(attachment.PositionY)px);
                width:@(attachment.Width)px;
                height:@(attachment.Height)px;">

                <div id="target_btns" class="flex gap-3 px-1 py-1" style="position:absolute; top:0; right:0; z-index:100;">
                    <button class="px-1 py-1 hover:pointer" style="color:red;" @onclick:stopPropagation="true"
                            @onclick="() => DeleteItem(attachment)">
                        <i class="fa fa-trash-o" aria-hidden="true"></i>
                    </button>
                </div>

                @if (attachment.Type.Equals(AppConstants.AttachmentType.Signature,
                                                                                                                                                                                                                                                                                                                                            StringComparison.InvariantCultureIgnoreCase))
                {
                    <img src="@signatureUrl" style="width:100%; height:100%; pointer-events:none;" />
                }
                else
                {
                    <div class="px-2 py-1" style="pointer-events:none;">@attachment.Content</div>
                }

                <div class="rh rh-n" data-handle="n"></div>
                <div class="rh rh-e" data-handle="e"></div>
                <div class="rh rh-s" data-handle="s"></div>
                <div class="rh rh-w" data-handle="w"></div>
                <div class="rh rh-ne" data-handle="ne"></div>
                <div class="rh rh-nw" data-handle="nw"></div>
                <div class="rh rh-se" data-handle="se"></div>
                <div class="rh rh-sw" data-handle="sw"></div>
            </div>
        }
    </div>
</div>