@using zxadocsfe.Services
@using zxadocslib.Helpers
@inject IJSRuntime JS
@inject ITemplateClientService TemplatesApi
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@implements IAsyncDisposable

@* Reusable rich-text editor for authoring/editing contract templates, backed by Quill 2
   (+ quill-table-better for tables). Author writes the contract body in the Quill Snow
   toolbar; "Insert field" drops a {{key}} token at the caret. The parent reads the HTML
   back on save via GetHtmlAsync().

   Images are uploaded to the backend and referenced by URL rather than inlined as base64
   (ZD-84). Saved HTML holds the canonical ?id= URL; the browser cannot send a bearer token
   for an img src, so a short-lived signed URL is swapped in for display only. *@

<div class="border border-slate-300 rounded-xl overflow-hidden">
    @* Import is always offered; the field menu only when the template defines merge fields. *@
    <div class="flex flex-wrap items-center gap-1 border-b border-slate-200 bg-slate-50 px-2 py-1">
        @if (Tokens is not null && Tokens.Any())
        {
            <MudMenu Label="Insert field" StartIcon="@Icons.Material.Filled.DataObject" Color="Color.Primary"
                     Variant="Variant.Text" Size="Size.Small" Dense="true">
                @foreach (var key in Tokens)
                {
                    <MudMenuItem OnClick="@(() => InsertToken(key))">@($"{{{{{key}}}}}")</MudMenuItem>
                }
            </MudMenu>
        }

        <MudButton OnClick="ImportDocument" StartIcon="@Icons.Material.Filled.UploadFile" Color="Color.Primary"
                   Variant="Variant.Text" Size="Size.Small" Disabled="importing">Import Word/PDF</MudButton>
    </div>

    @if (uploading)
    {
        <MudProgressLinear Color="Color.Primary" Value="@uploadProgress" Class="rounded-0" />
    }

    @* The author writes on a real A4 sheet: the container is the page width and the editor's
       own padding is replaced by the printed margin, so the text column is exactly the width
       that will print and an image occupies the same fraction of it here as in the PDF. *@
    <div class="zx-page-scroll overflow-auto bg-slate-100 py-6">
        <div class="zx-page mx-auto bg-white shadow-sm" style="@PageStyle">
            <div @ref="editor"></div>
        </div>
    </div>
</div>

@code {
    private static readonly string[] AllowedTypes = { "image/png", "image/jpeg", "image/gif", "image/webp" };

    [Parameter] public string? InitialHtml { get; set; }

    /// <summary>
    /// The editor Delta saved with the document, when there is one. Preferred over InitialHtml
    /// because a table does not survive an HTML round trip through the table plugin.
    /// </summary>
    [Parameter] public string? InitialDelta { get; set; }

    /// <summary>Merge-field keys offered in the "Insert field" menu (inserted as {{key}}).</summary>
    [Parameter] public IEnumerable<string>? Tokens { get; set; }

    /// <summary>Client-side size gate; mirrors the backend's Templates:MaxImageFileMb.</summary>
    [Parameter] public int MaxImageMb { get; set; } = 5;

    private ElementReference editor;
    private DotNetObjectReference<RichTextEditor>? selfRef;
    private bool uploading;
    private bool importing;
    private double uploadProgress;

    // The sheet is the full page; its padding is the printed margin, leaving a text column of
    // exactly PageGeometry.ContentWidthPx. Min-height is the page height so a short document
    // still looks like a page rather than a strip.
    private static string PageStyle =>
        $"width:{PageGeometry.WidthPx}px;min-height:{PageGeometry.HeightPx}px;" +
        $"padding:{PageGeometry.MarginCss}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("zxQuill.init", editor, InitialHtml ?? string.Empty, selfRef,
            PageGeometry.ContentWidthPx, InitialDelta);
        await RefreshImageUrlsAsync();
    }

    public ValueTask<string> GetHtmlAsync() => JS.InvokeAsync<string>("zxQuill.getHtml", editor);

    /// <summary>The editor's lossless content, stored alongside the HTML for re-editing.</summary>
    public ValueTask<string> GetDeltaAsync() => JS.InvokeAsync<string>("zxQuill.getDelta", editor);

    // Called from JS with an image the author picked, or with one extracted from an imported
    // document. Validation mirrors the backend so a rejectable file never leaves the browser.
    //
    // Returns the URL to display, leaving the CALLER to decide what to do with it: the toolbar
    // inserts it at the caret, while an import rewrites the src of the image it came from. Null
    // means the upload failed and the user has already been told.
    [JSInvokable]
    public async Task<string?> UploadImageAsync(string fileName, string contentType, string base64)
    {
        var bytes = Convert.FromBase64String(base64);

        if (!AllowedTypes.Contains(contentType, StringComparer.OrdinalIgnoreCase))
        {
            Snackbar.Add("Unsupported image type. Use PNG, JPEG, GIF or WEBP.", Severity.Error);
            return null;
        }
        if (bytes.LongLength > (long)MaxImageMb * 1024 * 1024)
        {
            Snackbar.Add($"Image exceeds the {MaxImageMb} MB limit.", Severity.Error);
            return null;
        }

        uploading = true;
        uploadProgress = 0;
        StateHasChanged();
        try
        {
            var progress = new Progress<double>(p => { uploadProgress = p; StateHasChanged(); });
            using var stream = new MemoryStream(bytes);
            var (ok, image, error) = await TemplatesApi.UploadImage(stream, fileName, progress);

            if (!ok || image is null)
            {
                // The editor content is untouched on failure — nothing was inserted.
                Snackbar.Add(error ?? "Image upload failed.", Severity.Error);
                return null;
            }

            // The signed URL is what displays; the server normalises it back to the canonical
            // form when the template is saved.
            return string.IsNullOrEmpty(image.DisplayUrl) ? image.Url : image.DisplayUrl;
        }
        finally
        {
            uploading = false;
            StateHasChanged();
        }
    }

    // Saved HTML carries canonical URLs a browser cannot load; exchange them for signed ones.
    private async Task RefreshImageUrlsAsync()
    {
        var ids = await JS.InvokeAsync<string[]>("zxQuill.imageIds", editor);
        if (ids.Length == 0) return;

        var (ok, signed, _) = await TemplatesApi.SignImages(ids);
        if (!ok || signed.Length == 0) return;

        await JS.InvokeVoidAsync("zxQuill.applyDisplayUrls", editor,
            signed.Select(s => new { id = s.Id, displayUrl = s.DisplayUrl }));
    }

    private ValueTask InsertToken(string key) =>
        JS.InvokeVoidAsync("zxQuill.insertText", editor, $"{{{{{key}}}}}");

    // ---- Import from Word/PDF (ZD-85) --------------------------------------------------
    //
    // The conversion runs in the browser: mammoth for DOCX, the already-loaded pdf.js for PDF.
    // The API is asked for nothing new — extracted images use the same upload as the toolbar's
    // image button, and the markup enters through the same paste path as saved content, so
    // Quill's own clipboard decides what survives.

    /// <summary>Prompts for a .docx/.pdf and replaces the editor's content with it.</summary>
    private async Task ImportDocument()
    {
        importing = true;
        try
        {
            await JS.InvokeVoidAsync("zxQuill.pickAndImport", editor);
        }
        finally
        {
            importing = false;
        }
    }

    // Called from JS before it replaces existing content: losing an authored body to a
    // mis-click is not recoverable, and MudBlazor's own message box keeps the prompt
    // consistent with the rest of the app.
    [JSInvokable]
    public async Task<bool> ConfirmImportAsync() =>
        await Dialogs.ShowMessageBoxAsync(
            "Replace the contract body?",
            "Importing replaces everything currently in the editor.",
            yesText: "Replace", cancelText: "Cancel") == true;

    [JSInvokable]
    public void ImportFailedAsync(string message)
    {
        Snackbar.Add($"Import failed: {message}", Severity.Error);
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
