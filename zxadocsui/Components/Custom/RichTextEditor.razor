@inject IJSRuntime JS

@* Reusable rich-text editor for authoring/editing contract templates, backed by Quill 2
   (+ quill-table-better for tables, base64 images). Author writes the contract body in the
   Quill Snow toolbar; "Insert field" drops a {{key}} token at the caret. The parent reads
   the HTML back on save via GetHtmlAsync(). Public API is unchanged from the previous
   contenteditable implementation. *@

<div class="border border-slate-300 rounded-xl overflow-hidden">
    @if (Tokens is not null && Tokens.Any())
    {
        <div class="flex flex-wrap items-center gap-1 border-b border-slate-200 bg-slate-50 px-2 py-1">
            <MudMenu Label="Insert field" StartIcon="@Icons.Material.Filled.DataObject" Color="Color.Primary"
                     Variant="Variant.Text" Size="Size.Small" Dense="true">
                @foreach (var key in Tokens)
                {
                    <MudMenuItem OnClick="@(() => InsertToken(key))">@($"{{{{{key}}}}}")</MudMenuItem>
                }
            </MudMenu>
        </div>
    }

    <div @ref="editor" class="min-h-[360px] max-h-[560px] overflow-y-auto"></div>
</div>

@code {
    [Parameter] public string? InitialHtml { get; set; }

    /// <summary>Merge-field keys offered in the "Insert field" menu (inserted as {{key}}).</summary>
    [Parameter] public IEnumerable<string>? Tokens { get; set; }

    private ElementReference editor;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("zxQuill.init", editor, InitialHtml ?? string.Empty);
        }
    }

    public ValueTask<string> GetHtmlAsync() => JS.InvokeAsync<string>("zxQuill.getHtml", editor);

    public ValueTask SetHtmlAsync(string html) => JS.InvokeVoidAsync("zxQuill.setHtml", editor, html);

    private ValueTask InsertToken(string key) =>
        JS.InvokeVoidAsync("zxQuill.insertText", editor, $"{{{{{key}}}}}");
}
