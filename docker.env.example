# Copy to docker.env. Overrides zxadocsui/.env, which compose loads first.
# Write bare values: docker does not strip quotes.

# The API runs as its own compose stack, so from here it is a host address.
# Trailing slash matters — this is passed to new Uri() as a base address.
# To share one docker network instead, make it external in both compose files
# and use the service name.
Api__BaseUrl=http://host.docker.internal:8080/
