@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<div class="testdiv"></div>
<div class="flex h-screen bg-gray-100">

    <div class="w-[20%] bg-white shadow-lg">
        <div class="p-4 border-b text-center">
            <h1 class="text-2xl font-bold text-blue-600!">Zxadocs</h1>
        </div>
        <div class="p-4">
            <button
                class="w-full flex items-center justify-center gap-2 bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition-colors">
                <i class="fa fa-plus-circle"></i>
                <span>
                    <NavLink class="nav-link" href="new-document">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> New Document
                    </NavLink>
                </span>
            </button>
        </div>

        <nav class="mt-4">
            <ul class="space-y-2 px-3">
                <li class="text-gray-700">
                    <div class="flex items-center py-2 font-medium">Documents</div>
                    <ul class="ml-4 space-y-1">

                        <li
                            class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                            <NavLink class="nav-link" href="/">Received</NavLink>
                        </li>
                        <li
                            class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                            <NavLink class="nav-link" href="sent-documents">Sent</NavLink>
                        </li>
                        <li
                            class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                            Drafts
                        </li>
                        <li
                            class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                            Archive
                        </li>
                    </ul>
                </li>
                <li
                    class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                    Templates
                </li>
                <li
                    class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                    Contracts
                </li>
            </ul>

            <div class="mt-8 px-3">
                <p class="text-xs font-semibold text-gray-400 mb-2">FOLDERS</p>
                <ul class="space-y-1">
                    <li
                        class="text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-2 py-1 rounded transition-colors cursor-pointer">
                        Invoices
                    </li>
                </ul>
            </div>
        </nav>
    </div>

    <main class="flex-1 overflow-auto">
        @Body

    </main>
</div>]