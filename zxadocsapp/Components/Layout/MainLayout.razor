@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Class="flex justify-between shadow-lg">
        <MudIconButton @rendermode="InteractiveServer" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" @onclick="DrawerToggle" Class="hover:bg-white/10 transition-colors" />


        <div id="menuicons" class="flex items-center gap-2">
            <MudMenu Icon="@Icons.Material.Filled.Favorite" Color="Color.Inherit" AriaLabel="Favorites"
                     Class="hover:bg-white/10">
                <MudMenuItem>Favorite 1</MudMenuItem>
                <MudMenuItem>Favorite 2</MudMenuItem>
            </MudMenu>

            <MudMenu Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" AriaLabel="Notifications"
                     Class="hover:bg-white/10">
                <MudMenuItem>Notification 1</MudMenuItem>
                <MudMenuItem>Notification 2</MudMenuItem>
            </MudMenu>

            <MudMenu Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" AriaLabel="Settings"
                     Class="hover:bg-white/10">
                <MudMenuItem>Settings</MudMenuItem>
                <MudMenuItem>Preferences</MudMenuItem>
            </MudMenu>

            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AriaLabel="Account"
                     Class="hover:bg-white/10">
                <MudMenuItem>Profile</MudMenuItem>
                <MudMenuItem>My Account</MudMenuItem>
                <MudDivider />
                <MudMenuItem>Logout</MudMenuItem>
            </MudMenu>
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" Clipped="true" Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#386641",
            Secondary = "#F97A00",
            Tertiary = "#FED16A",
            Info = "#FFF4A4",
            AppbarBackground = "#386641",
            DrawerBackground = "#f5f5f5",
            DrawerText = "#333",
            DrawerIcon = "#386641",
            Background = "#ffffff",
            Surface = "#f9f9f9"
        }
    };

    void DrawerToggle()
    {
        Console.WriteLine("Drawer toggle");
        _drawerOpen = !_drawerOpen;
    }
}