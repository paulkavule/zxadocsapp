@rendermode InteractiveServer
@page "/"
<div class="flex items-center justify-between mb-3">
    <div>
        <button @onclick="() => Login2()"> Login</button>
        <button @onclick="() => LoadDocuments()">Load</button>
    </div>
    <div class="shadow p-2 flex items-center gap-2 rounded-md">
        <span class="px-2  bg-red-500 rounded-full text-white">4</span>docs due today
    </div>
</div>

<div class="flex justify-between items-center mb-6">
    <div class="flex gap-5 items-center">
        <div class="flex gap-2 items-center px-4 py-2 hover:bg-gray-100 rounded-lg cursor-pointer transition-colors">
            <i class="fa fa-envelope-o text-gray-600"></i>
            <label class="text-gray-700 font-medium">All Received</label>
        </div>
        <div
            class="flex gap-2 items-center px-4 py-2 hover:bg-gray-100 rounded-lg cursor-pointer transition-colors border-b-2 border-blue-600">
            <i class="fa fa-clock-o text-gray-600"></i>
            <label class="text-gray-700 font-medium">Pending Action</label>
        </div>
        <div class="flex gap-2 items-center px-4 py-2 hover:bg-gray-100 rounded-lg cursor-pointer transition-colors">
            <i class="fa fa-file-text-o text-gray-600"></i>
            <label class="text-gray-700 font-medium">Completed</label>
        </div>
        <div class="flex gap-2 items-center px-4 py-2 hover:bg-gray-100 rounded-lg cursor-pointer transition-colors">
            <i class="fa fa-frown-o text-gray-600"></i>
            <label class="text-gray-700 font-medium">Rejected</label>
        </div>
    </div>
    <div class="relative">
        <div
            class="flex items-center bg-gray-50 rounded-lg px-4 py-2 border-2 border-gray-200 focus-within:ring-2 focus-within:ring-blue-100">
            <i class="fa fa-search text-gray-400 mr-2"></i>
            <input type="text" placeholder="Search docs"
                class="bg-transparent border-none outline-none placeholder-gray-400 text-gray-600 w-64 focus:ring-0" />
        </div>
    </div>
</div>

<div>
    <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden">
        <thead class="bg-gray-100">
            <tr>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Title</th>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Owner</th>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Status</th>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Last Action</th>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Due Date</th>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Received Date</th>
                <th class="py-3 px-6 text-left text-gray-600 font-medium">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in docList)
            {
                <tr class="border-b hover:bg-gray-50">
                    <td class="py-4 px-6">@doc.Title</td>
                    <td class="py-4 px-6"><i class="fa fa-user"></i> @doc.Author.Name</td>

                    <td class="py-4 px-6">
                        <span class="px-2 py-1 rounded-full text-white">
                            @doc.Status
                        </span>
                    </td>
                    <td class="py-4 px-6">@doc.LastAction</td>
                    <td class="py-4 px-6">@doc.DueDate</td>
                    <td class="py-4 px-6">@doc.RecieveDate</td>
                    <td class="py-4 px-6 flex items-center gap-3">
                        <button class="text-2xl text-green-500"><i class="fa fa-arrow-circle-o-up"></i></button>
                        <button class="text-2xl text-red-500"><i class="fa fa-window-close-o"></i></button>
                        @* <button class="text-blue-600 hover:underline">View</button> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>