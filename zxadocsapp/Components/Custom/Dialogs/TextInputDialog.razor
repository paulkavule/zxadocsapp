<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Title</MudText>

        <MudTextField Label="Label" @bind-Value="textInput" class="w-full h-[80%]" />

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
            OK
        </MudButton>
    </DialogActions>
</MudDialog>
@code {
    //[Inject] private IDialogService dialog { set; get; } = default;
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { set; get; } = string.Empty;
    [Parameter] public string Lable { set; get; } = string.Empty;
    [Parameter] public string InitialText { set; get; } = string.Empty;
    private string textInput = "";

    override protected void OnInitialized(){
        if(!string.IsNullOrEmpty(InitialText))
            textInput = InitialText;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        // Pass the text back to the caller via DialogResult.Data
        MudDialog.Close(DialogResult.Ok(textInput));
    }
}