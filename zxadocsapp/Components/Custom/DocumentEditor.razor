@rendermode InteractiveServer
@using zxadocsfe.Helpers;

<div class="pdf-toolbar">
    <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false">
        <MudIconButton Icon="@Icons.Material.Filled.ModeEdit" OnClick="AddSign"></MudIconButton>
        <MudIconButton Icon="@Icons.Material.Filled.Comment" OnClick="AddComment"></MudIconButton>

        <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" OnClick="ZoomOut" />
        <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" OnClick="ZoomIn" />
        <MudIconButton style="max-width: 50px;" Icon="@Icons.Material.Filled.SkipPrevious" OnClick="Prev" />
        <div class="flex items-center">
            <input type="number" min="1" max="@PageCount" value="@CurrentPage" @onchange="GoTo"
                   class="border-2 text-center" style="width:4rem; height:2rem" />
        </div>

        <MudIconButton Icon="@Icons.Material.Filled.SkipNext" OnClick="Next" />
        <div class="flex items-center">Page @CurrentPage of @PageCount | Zoom @Scale </div>
        <MudIconButton Icon="@Icons.Material.Filled.Save" OnClick="SaveDocument" />
    </MudButtonGroup>
    @* <button class="bg-amber-600" @onclick="AddSign">Add Signature</button>
    <button @onclick="Prev">Prev</button>
    <button @onclick="Next">Next</button>
    <button @onclick="ZoomOut">-</button>
    <span>Page @CurrentPage of @PageCount</span>
    <button @onclick="ZoomIn">+</button>
    <input type="number" min="1" max="@PageCount" value="@CurrentPage" @onchange="GoTo"
        style="width:4rem;margin-left:0.5rem;" /> *@
</div>

