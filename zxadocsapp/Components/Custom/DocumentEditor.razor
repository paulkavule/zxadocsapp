@rendermode InteractiveServer


<div class="pdf-toolbar">
    <button @onclick="AddSign">Add Signature</button>
    <button @onclick="Prev">Prev</button>
    <button @onclick="Next">Next</button>
    <button @onclick="ZoomOut">-</button>
    <span>Page @CurrentPage of @PageCount</span>
    <button @onclick="ZoomIn">+</button>
    <input type="number" min="1" max="@PageCount" value="@CurrentPage" @onchange="GoTo"
        style="width:4rem;margin-left:0.5rem;" />
</div>

<div @ref="pdfCanvas" id="@_containerId"
    style="width:100%;max-width:100%;border:1px solid #ddd;min-height:60vh; position:relative">
    @for (int item = 0; item < divCount; item++)
    {
        var itemRef = "draggable" + item;
        <div class="signBox resizable" id="@itemRef" @onclick="() => InitializeDrag(itemRef)">
            this is the representation of a signature

            <div class="rh rh-n" data-handle="n"></div>
            <div class="rh rh-e" data-handle="e"></div>
            <div class="rh rh-s" data-handle="s"></div>
            <div class="rh rh-w" data-handle="w"></div>
            <div class="rh rh-ne" data-handle="ne"></div>
            <div class="rh rh-nw" data-handle="nw"></div>
            <div class="rh rh-se" data-handle="se"></div>
            <div class="rh rh-sw" data-handle="sw"></div>
        </div>

    }
</div>