@using twapp.Components.Menu
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton ren Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="DrawerToggle" />
        Zxadocs
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" Clipped="true" Breakpoint="Breakpoint.Md">
        <MainMenu />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        Console.WriteLine("Drawer toggle");
        _drawerOpen = !_drawerOpen;
    }
}